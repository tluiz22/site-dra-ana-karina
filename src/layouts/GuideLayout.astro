---
import BaseLayout from "./BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Notice from "../components/Notice.astro";
import FinalCta from "../components/FinalCta.astro";
import { doctor } from "../data/doctor";

interface Props {
  title: string;
  subtitle: string;
  description: string;
  canonical: string;
}

const { title, subtitle, description, canonical } = Astro.props;
---

<BaseLayout
  title={`${title} | Guia para pais | ${doctor.professionalName}`}
  description={description}
  canonical={canonical}
>
  <article>
    <PageHeader
      eyebrow="Guia para pais e responsáveis"
      title={title}
      subtitle={subtitle}
      width="prose"
      byline
    >
    </PageHeader>

    <div class="container-prose">
      <div class="prose">
        <slot />
      </div>

      <Notice variant="educational" class="mt-12">
        Traga este guia na próxima consulta para conversar com calma sobre o cuidado do seu filho.
      </Notice>

      <nav aria-label="Navegação dos guias" class="mt-10 border-t border-line pt-6">
        <a href="/guias" class="link-action inline-flex min-h-11 items-center">
          <span aria-hidden="true">←&nbsp;</span>Voltar aos guias
        </a>
      </nav>
    </div>
  </article>

  <div class="mt-10">
    <FinalCta
      origin="click_whatsapp_guia_footer"
      title="Quer conversar sobre o cuidado do seu filho?"
      text="Agende uma consulta e leve este guia com você."
      compact
    />
  </div>
</BaseLayout>
