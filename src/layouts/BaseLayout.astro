---
import SeoHead from "../components/SeoHead.astro";
import StructuredData from "../components/StructuredData.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  type?: "website" | "article";
  noindex?: boolean;
}

const { title, description, canonical, ogImage, type, noindex } = Astro.props;
---

<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      type={type}
      noindex={noindex}
    />
    <StructuredData />
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-95LN9KB42N"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-95LN9KB42N");
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-white text-slate-900">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton label="WhatsApp" origin="click_whatsapp_floating" floating={true} />
    <script is:inline>
      document.addEventListener("click", (event) => {
        const target = event.target.closest("[data-analytics-event]");
        if (!target || typeof window.gtag !== "function") return;
        window.gtag("event", target.getAttribute("data-analytics-event"));
      });
    </script>
  </body>
</html>
