---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ContentListItem from '../../components/ContentListItem.astro';

const allGuides = await getCollection('guias', ({ data }) => !data.draft);
const guides = allGuides.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Guias para pais | Pneumologista pediátrica em Mossoró"
  description="Guias práticos e gratuitos da Dra. Ana Karina para pais e responsáveis cuidarem da saúde respiratória dos filhos em casa."
  canonical={Astro.url.href}
>
  <PageHeader
    eyebrow="Guias para pais"
    title="Para ler com calma, em casa"
    subtitle="Materiais educativos práticos, escritos pela Dra. Ana Karina, para apoiar o dia a dia do cuidado respiratório em casa. Cada guia tem versão em PDF."
  />

  <section class="container-text pb-(--space-section)">
    {guides.length === 0 ? (
      <p class="text-ink-secondary">Nenhum guia publicado ainda.</p>
    ) : (
      <ul class="border-b border-line">
        {guides.map((guide) => (
          <ContentListItem
            href={`/guias/${guide.id}`}
            category={guide.data.condition}
            title={guide.data.title}
            subtitle={guide.data.subtitle}
            description={guide.data.description}
          />
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
