---
import "../../styles/global.css";
import Footer from "../../components/Footer.astro";
import { createServiceClient } from "../../lib/supabase/service";
import { getNextAvailableDates } from "../../lib/scheduling/getNextAvailableDates";
import { getAvailableSlotsForDate, type AppointmentType } from "../../lib/scheduling/getAvailableSlotsForDate";
import { getNextAvailableGroupDates, type AvailableGroupSession } from "../../lib/scheduling/getNextAvailableGroupDates";
import { getExamNextAvailableDates } from "../../lib/scheduling/getExamNextAvailableDates";
import { getExamAvailableSlotsForDate } from "../../lib/scheduling/getExamAvailableSlotsForDate";
import { resolveClinicLocationIds } from "../../lib/scheduling/resolveClinicLocationIds";
import { formatPhoneBR } from "../../lib/phone";

const { token } = Astro.params;
const supabase = createServiceClient();

const { data: link } = token
  ? await supabase
      .from("booking_links")
      .select(
        `id, mode, appointment_type, clinic_location_id, location_category, expires_at, used_at, exam_type_id,
         guardians ( full_name, phone ),
         patients ( full_name, birthdate ),
         appointments ( scheduled_at, clinic_locations ( name, type, address ) ),
         exam_types ( name, duration_minutes, preparation_instructions, scheduling_mode )`
      )
      .eq("id", token)
      .maybeSingle()
  : { data: null };

type PageState = "invalid" | "used" | "expired" | "form";

const state: PageState = !link
  ? "invalid"
  : link.used_at
    ? "used"
    : new Date(link.expires_at) < new Date()
      ? "expired"
      : "form";

const guardian = (link?.guardians ?? null) as unknown as { full_name: string; phone: string } | null;
const patient = (link?.patients ?? null) as unknown as { full_name: string; birthdate: string } | null;
// Populado em modo "reschedule" (a consulta/exame sendo remarcado) e depois
// de confirmar em modo "create" (o agendamento recém-criado) — nos dois
// casos já existe um `clinic_location_id` resolvido para um local físico
// específico (diferente do link em si, que só sabe a categoria antes de
// confirmar; ver "Backlog futuro — Múltiplos consultórios" no plano).
const currentAppointment = (link?.appointments ?? null) as unknown as {
  scheduled_at: string;
  clinic_locations: { name: string; type: string; address: string | null } | null;
} | null;
const examType = (link?.exam_types ?? null) as unknown as {
  name: string;
  duration_minutes: number;
  preparation_instructions: string | null;
  scheduling_mode: string;
} | null;
const isGroupExam = link?.appointment_type === "exam" && examType?.scheduling_mode === "group";

function categoryLabel(type: string | undefined | null): string {
  return type === "home_visit" ? "Atendimento domiciliar" : type === "exam" ? "Exames" : "Consultório";
}

// Antes de confirmar: só sabemos a categoria (Consultório/Domiciliar/Exames).
// Depois de confirmar: sabemos o consultório físico exato.
const locationLabel = categoryLabel(
  currentAppointment?.clinic_locations?.type ?? link?.location_category ?? (link?.appointment_type === "exam" ? "exam" : undefined)
);

function formatDateBR(dateStr: string): string {
  const [year, month, day] = dateStr.split("-");
  return `${day}/${month}/${year}`;
}

function formatWeekdayFull(dateStr: string): string {
  const label = new Intl.DateTimeFormat("pt-BR", { weekday: "long", timeZone: "America/Fortaleza" }).format(
    new Date(`${dateStr}T12:00:00-03:00`)
  );
  return label.charAt(0).toUpperCase() + label.slice(1);
}

function formatDateTimeBR(iso: string): string {
  const datePart = new Intl.DateTimeFormat("pt-BR", {
    timeZone: "America/Fortaleza",
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
  }).format(new Date(iso));
  const timePart = new Intl.DateTimeFormat("pt-BR", {
    timeZone: "America/Fortaleza",
    hour: "2-digit",
    minute: "2-digit",
    hour12: false,
  })
    .format(new Date(iso))
    .replace(":", "h");
  return `${datePart} às ${timePart}`;
}

function groupSessionStartIso(session: AvailableGroupSession): string {
  return new Date(`${session.date}T${session.startTime}:00-03:00`).toISOString();
}

let availableDates: { date: string; weekday: number }[] = [];
let initialSlots: { start: Date; label: string; clinicLocationId: string }[] = [];
let groupDateOptions: AvailableGroupSession[] = [];
let selectedGroupSession: AvailableGroupSession | undefined;
let selectedDate = "";

if (state === "form" && link) {
  const appointmentType = link.appointment_type as AppointmentType;
  const examDurationMinutes = examType?.duration_minutes;

  if (isGroupExam) {
    // Exame em grupo: sem freebusy do Calendar, um único horário fixo por
    // dia da semana — a "Data" já carrega o horário junto (ver script no
    // fim da página), sem etapa separada de escolher horário.
    const sessions = await getNextAvailableGroupDates({ supabase, examTypeId: link.exam_type_id ?? "" });
    const seenDates = new Set<string>();
    for (const session of sessions) {
      if (seenDates.has(session.date)) continue;
      seenDates.add(session.date);
      groupDateOptions.push(session);
    }

    const dateParam = Astro.url.searchParams.get("date");
    selectedDate =
      dateParam && groupDateOptions.some((d) => d.date === dateParam) ? dateParam : (groupDateOptions[0]?.date ?? "");
    selectedGroupSession = groupDateOptions.find((d) => d.date === selectedDate);
  } else if (appointmentType === "exam") {
    // Exame individual: disponibilidade própria do exame (cada um tem a
    // sua, não compartilha com nenhum local — ver Fase 11).
    const examTypeId = link.exam_type_id ?? "";
    const examLocationId = link.clinic_location_id ?? "";

    availableDates = examTypeId
      ? await getExamNextAvailableDates({
          supabase,
          examTypeId,
          examLocationId,
          examDurationMinutes: examDurationMinutes ?? 0,
        })
      : [];

    const dateParam = Astro.url.searchParams.get("date");
    selectedDate =
      dateParam && availableDates.some((d) => d.date === dateParam) ? dateParam : (availableDates[0]?.date ?? "");

    if (selectedDate && examTypeId) {
      initialSlots = await getExamAvailableSlotsForDate({
        supabase,
        examTypeId,
        examLocationId,
        date: selectedDate,
        examDurationMinutes: examDurationMinutes ?? 0,
      });
    }
  } else {
    // Consulta/retorno: categoria mesclando todos os consultórios físicos
    // ativos dela (ver "Backlog futuro" no plano).
    const clinicLocationIds = await resolveClinicLocationIds(supabase, (link.location_category as "clinic" | "home_visit") ?? "clinic");

    availableDates = await getNextAvailableDates({
      supabase,
      clinicLocationIds,
      appointmentType,
      examDurationMinutes,
    });

    const dateParam = Astro.url.searchParams.get("date");
    selectedDate =
      dateParam && availableDates.some((d) => d.date === dateParam) ? dateParam : (availableDates[0]?.date ?? "");

    if (selectedDate) {
      initialSlots = await getAvailableSlotsForDate({
        supabase,
        clinicLocationIds,
        date: selectedDate,
        appointmentType,
        examDurationMinutes,
      });
    }
  }
}

const errorMessages: Record<string, string> = {
  slot_taken: "Esse horário acabou de deixar de estar livre. Escolha outro.",
  "1": "Não foi possível confirmar a consulta. Tente novamente.",
};
const errorParam = Astro.url.searchParams.get("error");
const errorMessage = errorParam ? (errorMessages[errorParam] ?? errorMessages["1"]) : null;

const isExam = link?.appointment_type === "exam";

const pageTitle = link?.mode === "reschedule" ? "Remarcar consulta" : isExam ? "Marcar exame" : "Agendar consulta";

const confirmedLocation = currentAppointment?.clinic_locations ?? null;
---

<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{pageTitle} | Dra. Ana Karina Fernandes</title>
  </head>
  <body class="flex min-h-screen flex-col bg-slate-50 text-slate-900">
    <main class="mx-auto w-full max-w-xl flex-1 px-4 py-10">
      {
        state === "invalid" && (
          <div class="rounded-md border border-slate-200 bg-white p-6 text-center">
            <h1 class="text-lg font-bold text-slate-900">Link inválido</h1>
            <p class="mt-2 text-sm text-slate-600">
              Este link de agendamento não existe. Volte à conversa no WhatsApp e peça um novo.
            </p>
          </div>
        )
      }

      {
        state === "expired" && (
          <div class="rounded-md border border-slate-200 bg-white p-6 text-center">
            <h1 class="text-lg font-bold text-slate-900">Link expirado</h1>
            <p class="mt-2 text-sm text-slate-600">
              Este link de agendamento venceu. Volte à conversa no WhatsApp e peça um novo link.
            </p>
          </div>
        )
      }

      {
        state === "used" && (
          <div class="rounded-md border border-emerald-200 bg-emerald-50 p-6 text-center">
            <h1 class="text-lg font-bold text-emerald-900">{isExam ? "Exame confirmado!" : "Consulta confirmada!"}</h1>
            <p class="mt-2 text-sm text-emerald-800">
              {patient?.full_name}
              {currentAppointment && (
                <>
                  {" "}
                  — {formatDateTimeBR(currentAppointment.scheduled_at)} · {locationLabel}
                </>
              )}
            </p>
            {confirmedLocation?.address && (
              <p class="mt-2 text-sm text-emerald-800">
                {confirmedLocation.name}
                <br />
                {confirmedLocation.address}
              </p>
            )}
            <p class="mt-4 text-sm text-emerald-800">
              Você também vai receber a confirmação pelo WhatsApp.
            </p>
            <a
              href="https://draanakarinapneumo.com.br"
              class="mt-6 inline-block rounded-md bg-sky-700 px-4 py-2 text-sm font-medium text-white hover:bg-sky-800"
            >
              Voltar para o site
            </a>
          </div>
        )
      }

      {
        state === "form" && link && (
          <>
            <h1 class="text-2xl font-bold text-slate-900">{pageTitle}</h1>
            <p class="mt-1 text-sm text-slate-600">
              {link.appointment_type === "exam"
                ? examType?.name ?? "Exame"
                : `${locationLabel} · ${link.appointment_type === "return_visit" ? "Retorno" : "Consulta"}`}
            </p>

            {link.mode === "reschedule" && currentAppointment && (
              <p class="mt-2 text-sm text-slate-600">
                {isExam ? "Exame atual" : "Consulta atual"}: {formatDateTimeBR(currentAppointment.scheduled_at)}
              </p>
            )}

            {link.appointment_type === "exam" && examType?.preparation_instructions && (
              <p class="mt-3 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900">
                <strong>Preparo:</strong> {examType.preparation_instructions}
              </p>
            )}

            {errorMessage && (
              <p class="mt-4 rounded-md bg-red-50 px-3 py-2 text-sm text-red-700">{errorMessage}</p>
            )}

            <div class="mt-6 rounded-md border border-slate-200 bg-white p-4 text-sm text-slate-700">
              <p class="font-medium text-slate-900">Responsável</p>
              <p>
                {guardian?.full_name} · {guardian?.phone && formatPhoneBR(guardian.phone)}
              </p>
            </div>

            <div class="mt-3 rounded-md border border-slate-200 bg-white p-4 text-sm text-slate-700">
              <p class="font-medium text-slate-900">Criança</p>
              <p>
                {patient?.full_name}
                {patient?.birthdate && ` · nascido(a) em ${formatDateBR(patient.birthdate)}`}
              </p>
            </div>

            <form
              method="POST"
              action={`/api/agendar/${link.id}/confirmar`}
              class="mt-6 flex flex-col gap-6"
            >
              <div>
                <label for="date" class="block text-sm font-medium text-slate-700">
                  {isExam ? "Data do exame" : "Data da consulta"}
                </label>
                {isGroupExam ? (
                  groupDateOptions.length ? (
                    <select
                      id="date"
                      name="date"
                      class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm"
                    >
                      {groupDateOptions.map((session) => (
                        <option
                          value={session.date}
                          selected={session.date === selectedDate}
                          data-start={groupSessionStartIso(session)}
                          data-start-label={session.startTime}
                          data-end-label={session.endTime}
                          data-remaining={session.remainingCapacity}
                        >
                          {formatWeekdayFull(session.date)}, {formatDateBR(session.date)}
                        </option>
                      ))}
                    </select>
                  ) : (
                    <p class="mt-1 text-sm text-slate-500">
                      Não encontramos vaga nos próximos dias. Fale com a secretária pelo WhatsApp.
                    </p>
                  )
                ) : availableDates.length ? (
                  <select
                    id="date"
                    name="date"
                    class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm"
                  >
                    {availableDates.map((d) => (
                      <option value={d.date} selected={d.date === selectedDate}>
                        {formatWeekdayFull(d.date)}, {formatDateBR(d.date)}
                      </option>
                    ))}
                  </select>
                ) : (
                  <p class="mt-1 text-sm text-slate-500">
                    Não encontramos horários livres nos próximos dias. Fale com a secretária pelo
                    WhatsApp.
                  </p>
                )}
              </div>

              {isGroupExam ? (
                <div>
                  <span class="block text-sm font-medium text-slate-700">Horário do exame</span>
                  <p id="group_session_info" class="mt-1 text-sm text-slate-600">
                    {selectedGroupSession && (
                      <>
                        Esse exame é sempre das {selectedGroupSession.startTime} às {selectedGroupSession.endTime} —
                        escolha só a data. Vagas: {selectedGroupSession.remainingCapacity}.
                      </>
                    )}
                  </p>
                  <input
                    type="hidden"
                    id="group_start"
                    name="start"
                    value={selectedGroupSession ? `${groupSessionStartIso(selectedGroupSession)}|${link.clinic_location_id ?? ""}` : ""}
                  />
                </div>
              ) : (
                <div>
                  <span class="block text-sm font-medium text-slate-700">{isExam ? "Horário do exame" : "Horário da consulta"}</span>
                  <div id="slots_container" class="mt-1 flex flex-wrap gap-2">
                    {initialSlots.length ? (
                      initialSlots.map((slot) => (
                        <label class="cursor-pointer rounded-md border border-slate-300 px-3 py-2 text-sm has-[:checked]:border-sky-700 has-[:checked]:bg-sky-50">
                          <input
                            type="radio"
                            name="start"
                            value={`${slot.start.toISOString()}|${slot.clinicLocationId}`}
                            required
                            class="mr-1"
                          />
                          {slot.label}
                        </label>
                      ))
                    ) : (
                      <p class="text-sm text-slate-500">Nenhum horário livre nesse dia. Escolha outra data.</p>
                    )}
                  </div>
                </div>
              )}

              <button
                id="submit_btn"
                type="submit"
                disabled={isGroupExam ? !groupDateOptions.length : !availableDates.length}
                class="w-fit rounded-md bg-sky-700 px-4 py-2 text-sm font-medium text-white hover:bg-sky-800 disabled:cursor-not-allowed disabled:opacity-50"
              >
                {isExam ? "Confirmar exame" : "Confirmar consulta"}
              </button>
            </form>
          </>
        )
      }
    </main>
    <Footer hideAddress />
  </body>
</html>

<script define:vars={{ token: link?.id ?? "" }} is:inline>
  window.__bookingToken = token;
</script>
<script>
  const dateSelect = document.getElementById("date") as HTMLSelectElement | null;
  const slotsContainer = document.getElementById("slots_container") as HTMLDivElement | null;
  const submitBtn = document.getElementById("submit_btn") as HTMLButtonElement | null;
  const token = (window as any).__bookingToken as string;

  if (dateSelect && slotsContainer && submitBtn && token) {
    dateSelect.addEventListener("change", async () => {
      slotsContainer.innerHTML = '<p class="text-sm text-slate-500">Buscando horários…</p>';
      submitBtn.disabled = true;

      const params = new URLSearchParams({ date: dateSelect.value });
      const response = await fetch(`/api/agendar/${token}/slots?${params.toString()}`);

      if (!response.ok) {
        slotsContainer.innerHTML =
          '<p class="text-sm text-red-700">Não foi possível buscar os horários. Tente novamente.</p>';
        return;
      }

      const { slots } = await response.json();
      slotsContainer.innerHTML = "";

      if (!slots.length) {
        slotsContainer.innerHTML =
          '<p class="text-sm text-slate-500">Nenhum horário livre nesse dia. Escolha outra data.</p>';
        return;
      }

      submitBtn.disabled = false;
      slots.forEach((slot: { start: string; label: string; clinicLocationId: string }) => {
        const label = document.createElement("label");
        label.className =
          "cursor-pointer rounded-md border border-slate-300 px-3 py-2 text-sm has-[:checked]:border-sky-700 has-[:checked]:bg-sky-50";
        const input = document.createElement("input");
        input.type = "radio";
        input.name = "start";
        input.value = `${slot.start}|${slot.clinicLocationId}`;
        input.required = true;
        input.className = "mr-1";
        label.appendChild(input);
        label.append(slot.label);
        slotsContainer.appendChild(label);
      });
    });
  }
</script>
<script>
  // Exame em grupo: cada <option> de data já carrega o horário fixo e as
  // vagas (dataset), então trocar a data não precisa de fetch nenhum — só
  // atualizar o texto informativo e o campo escondido "start".
  const groupDateSelect = document.getElementById("date") as HTMLSelectElement | null;
  const groupSessionInfo = document.getElementById("group_session_info") as HTMLParagraphElement | null;
  const groupStartInput = document.getElementById("group_start") as HTMLInputElement | null;

  if (groupDateSelect && groupSessionInfo && groupStartInput) {
    const clinicLocationId = groupStartInput.value.split("|")[1] ?? "";

    groupDateSelect.addEventListener("change", () => {
      const option = groupDateSelect.selectedOptions[0];
      const start = option?.dataset.start;
      const startLabel = option?.dataset.startLabel;
      const endLabel = option?.dataset.endLabel;
      const remaining = option?.dataset.remaining;

      if (!start) return;

      groupStartInput.value = `${start}|${clinicLocationId}`;
      groupSessionInfo.textContent =
        `Esse exame é sempre das ${startLabel} às ${endLabel} — escolha só a data. Vagas: ${remaining}.`;
    });
  }
</script>
