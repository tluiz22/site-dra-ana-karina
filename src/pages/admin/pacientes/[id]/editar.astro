---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import { createClient } from "../../../../lib/supabase/server";

const supabase = createClient(Astro.request, Astro.cookies);
const { id } = Astro.params;

const { data: guardian } = await supabase
  .from("guardians")
  .select("id, full_name, phone")
  .eq("id", id)
  .maybeSingle();

if (!guardian) {
  return Astro.redirect("/admin/pacientes?error=not_found");
}

const errorMessages: Record<string, string> = {
  invalid_phone: "Telefone inválido — informe DDD + número, ex.: 84981880777.",
  "1": "Não foi possível salvar. Confira os dados e tente novamente.",
};
const errorParam = Astro.url.searchParams.get("error");
const errorMessage = errorParam ? (errorMessages[errorParam] ?? errorMessages["1"]) : null;
---

<AdminLayout title={`Editar ${guardian.full_name}`}>
  <a href={`/admin/pacientes/${guardian.id}`} class="text-sm text-sky-700 hover:underline">
    &larr; {guardian.full_name}
  </a>

  <h1 class="mt-3 text-2xl font-bold text-slate-900">Editar responsável</h1>

  {
    errorMessage && (
      <p class="mt-4 rounded-md bg-red-50 px-3 py-2 text-sm text-red-700">{errorMessage}</p>
    )
  }

  <form
    method="POST"
    action={`/api/admin/pacientes/${guardian.id}/editar`}
    class="mt-4 flex max-w-xl flex-col gap-3 rounded-md border border-slate-200 bg-white p-4"
  >
    <div>
      <label for="full_name" class="block text-sm font-medium text-slate-700">Nome</label>
      <input
        type="text"
        id="full_name"
        name="full_name"
        value={guardian.full_name}
        required
        class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm"
      />
    </div>
    <div>
      <label for="phone" class="block text-sm font-medium text-slate-700">Telefone</label>
      <input
        type="tel"
        id="phone"
        name="phone"
        value={guardian.phone}
        required
        class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm"
      />
    </div>
    <button
      type="submit"
      class="mt-2 w-fit rounded-md bg-sky-700 px-4 py-2 text-sm font-medium text-white hover:bg-sky-800"
    >
      Salvar
    </button>
  </form>
</AdminLayout>
