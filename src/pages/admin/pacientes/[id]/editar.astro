---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import Card from "../../../../components/admin/Card.astro";
import Icon from "../../../../components/admin/Icon.astro";
import { createClient } from "../../../../lib/supabase/server";

const supabase = createClient(Astro.request, Astro.cookies);
const { id } = Astro.params;

const { data: guardian } = await supabase
  .from("guardians")
  .select("id, full_name, phone")
  .eq("id", id)
  .maybeSingle();

if (!guardian) {
  return Astro.redirect("/admin/pacientes?error=not_found");
}

const errorMessages: Record<string, string> = {
  invalid_phone: "Telefone inválido — informe DDD + número, ex.: 84981880777.",
  "1": "Não foi possível salvar. Confira os dados e tente novamente.",
};
const errorParam = Astro.url.searchParams.get("error");
const errorMessage = errorParam ? (errorMessages[errorParam] ?? errorMessages["1"]) : null;
---

<AdminLayout title={`Editar ${guardian.full_name}`}>
  <a
    href={`/admin/pacientes/${guardian.id}`}
    class="inline-flex items-center gap-1 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-50"
  >
    <Icon name="chevron-left" class="h-4 w-4" />
    {guardian.full_name}
  </a>

  <h1 class="mt-3 text-2xl font-bold text-slate-900">Editar responsável</h1>

  {
    errorMessage && (
      <p class="mt-4 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">{errorMessage}</p>
    )
  }

  <Card class="mt-4 max-w-xl">
    <form method="POST" action={`/api/admin/pacientes/${guardian.id}/editar`} class="flex flex-col gap-4">
      <div>
        <label for="full_name" class="block text-sm font-medium text-slate-700">Nome</label>
        <input
          type="text"
          id="full_name"
          name="full_name"
          value={guardian.full_name}
          required
          class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-sky-600 focus:outline-none focus:ring-1 focus:ring-sky-600"
        />
      </div>
      <div>
        <label for="phone" class="block text-sm font-medium text-slate-700">Telefone</label>
        <input
          type="tel"
          id="phone"
          name="phone"
          value={guardian.phone}
          required
          class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-sky-600 focus:outline-none focus:ring-1 focus:ring-sky-600"
        />
      </div>
      <div class="flex flex-col-reverse gap-2 sm:flex-row sm:items-center">
        <a
          href={`/admin/pacientes/${guardian.id}`}
          class="w-full rounded-md border border-slate-300 px-4 py-3 text-center text-sm font-semibold text-slate-600 hover:bg-slate-50 sm:w-fit"
        >
          Cancelar
        </a>
        <button
          type="submit"
          class="w-full rounded-md bg-sky-700 px-4 py-3 text-sm font-semibold text-white hover:bg-sky-800 sm:w-fit"
        >
          Salvar
        </button>
      </div>
    </form>
  </Card>
</AdminLayout>
