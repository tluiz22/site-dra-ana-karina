---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import Card from "../../../../components/admin/Card.astro";
import Badge from "../../../../components/admin/Badge.astro";
import Icon from "../../../../components/admin/Icon.astro";
import ConfirmDeleteDialog from "../../../../components/admin/ConfirmDeleteDialog.astro";
import { createClient } from "../../../../lib/supabase/server";

const PAGE_SIZE = 20;

const supabase = createClient(Astro.request, Astro.cookies);
const { id } = Astro.params;

const { data: guardian } = await supabase
  .from("guardians")
  .select("id, full_name, phone, is_active")
  .eq("id", id)
  .maybeSingle();

if (!guardian) {
  return Astro.redirect("/admin/pacientes?error=not_found");
}

const errorMessages: Record<string, string> = {
  invalid_birthdate: "Data de nascimento inválida.",
  not_found: "Criança não encontrada.",
  "1": "Não foi possível salvar. Confira os dados e tente novamente.",
};
const errorParam = Astro.url.searchParams.get("error");
const errorMessage = errorParam ? (errorMessages[errorParam] ?? errorMessages["1"]) : null;

const q = Astro.url.searchParams.get("q")?.trim() ?? "";
const showInactive = Astro.url.searchParams.get("show_inactive") === "1";
const page = Math.max(1, Number(Astro.url.searchParams.get("page")) || 1);
const from = (page - 1) * PAGE_SIZE;
const to = from + PAGE_SIZE - 1;

let patientsQuery = supabase
  .from("patients")
  .select("id, full_name, birthdate, notes, is_active", { count: "exact" })
  .eq("guardian_id", id)
  .order("full_name")
  .range(from, to);

if (!showInactive) patientsQuery = patientsQuery.eq("is_active", true);
if (q) patientsQuery = patientsQuery.ilike("full_name", `%${q}%`);

const { data: patients, count } = await patientsQuery;
const totalPages = Math.max(1, Math.ceil((count ?? 0) / PAGE_SIZE));

function pageUrl(targetPage: number): string {
  const params = new URLSearchParams();
  if (q) params.set("q", q);
  if (showInactive) params.set("show_inactive", "1");
  params.set("page", String(targetPage));
  return `/admin/pacientes/${id}?${params.toString()}`;
}

function formatBirthdate(birthdate: string): string {
  const [year, month, day] = birthdate.split("-");
  return `${day}/${month}/${year}`;
}
---

<AdminLayout title={guardian.full_name}>
  <a
    href="/admin/pacientes"
    class="inline-flex items-center gap-1 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-50"
  >
    <Icon name="chevron-left" class="h-4 w-4" />
    Pacientes
  </a>

  {
    errorMessage && (
      <p class="mt-4 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">{errorMessage}</p>
    )
  }

  <Card class="mt-3 flex flex-wrap items-start justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">
        {guardian.full_name}
        {!guardian.is_active && (
          <Badge variant="neutral" class="ml-2 align-middle">
            Inativo
          </Badge>
        )}
      </h1>
      <p class="mt-1 text-slate-600">{guardian.phone}</p>
    </div>
    <div class="flex gap-2">
      <a
        href={`/admin/pacientes/${guardian.id}/editar`}
        class="rounded-md border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-50"
      >
        Editar
      </a>
      {
        guardian.is_active ? (
          <form method="POST" action={`/api/admin/pacientes/${guardian.id}/excluir`}>
            <button
              type="submit"
              class="js-confirm-delete rounded-md border border-red-200 px-3 py-1.5 text-sm font-medium text-red-700 hover:bg-red-50"
              data-confirm-message={`Excluir ${guardian.full_name}? Fica marcado como inativo — os dados continuam guardados e dá pra reativar depois.`}
            >
              Excluir
            </button>
          </form>
        ) : (
          <form method="POST" action={`/api/admin/pacientes/${guardian.id}/reativar`}>
            <button
              type="submit"
              class="rounded-md border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-50"
            >
              Reativar
            </button>
          </form>
        )
      }
    </div>
  </Card>

  <section class="mt-10">
    <h2 class="text-lg font-semibold text-slate-900">Adicionar criança</h2>

    <Card class="mt-4 max-w-xl">
      <form method="POST" action={`/api/admin/pacientes/${guardian.id}/criancas`} class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <label for="full_name" class="block text-sm font-medium text-slate-700">Nome</label>
          <input
            type="text"
            id="full_name"
            name="full_name"
            required
            class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-sky-600 focus:outline-none focus:ring-1 focus:ring-sky-600"
          />
        </div>
        <div>
          <label for="birthdate" class="block text-sm font-medium text-slate-700">
            Data de nascimento
          </label>
          <input
            type="date"
            id="birthdate"
            name="birthdate"
            min="1900-01-01"
            max={new Date().toISOString().slice(0, 10)}
            required
            class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-sky-600 focus:outline-none focus:ring-1 focus:ring-sky-600"
          />
        </div>
        <div class="sm:col-span-2">
          <label for="notes" class="block text-sm font-medium text-slate-700">
            Observação (operacional, não clínica)
          </label>
          <input
            type="text"
            id="notes"
            name="notes"
            placeholder="ex.: prefere período da manhã"
            class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-sky-600 focus:outline-none focus:ring-1 focus:ring-sky-600"
          />
        </div>
        <button
          type="submit"
          class="mt-2 w-full rounded-md bg-sky-700 px-4 py-3 text-sm font-semibold text-white hover:bg-sky-800 sm:col-span-2 sm:w-fit"
        >
          Adicionar
        </button>
      </form>
    </Card>
  </section>

  <section class="mt-10">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 class="text-lg font-semibold text-slate-900">Crianças cadastradas</h2>
      <form method="GET" action={`/admin/pacientes/${guardian.id}`} class="flex flex-wrap items-center gap-3">
        <input
          type="search"
          name="q"
          value={q}
          placeholder="Buscar por nome"
          class="w-64 rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-sky-600 focus:outline-none focus:ring-1 focus:ring-sky-600"
        />
        <label class="flex items-center gap-1.5 text-sm text-slate-600">
          <input
            type="checkbox"
            name="show_inactive"
            value="1"
            checked={showInactive}
            class="rounded border-slate-300 text-sky-700 focus:ring-sky-600"
          />
          Mostrar inativas
        </label>
        <button
          type="submit"
          class="rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50"
        >
          Buscar
        </button>
      </form>
    </div>

    <div class="mt-4 overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm">
      <table class="w-full min-w-[560px] border-collapse text-left text-sm">
        <thead class="bg-slate-50 text-slate-600">
          <tr>
            <th class="px-3 py-2 font-medium">Nome</th>
            <th class="px-3 py-2 font-medium">Nascimento</th>
            <th class="px-3 py-2 font-medium">Observação</th>
            <th class="px-3 py-2"></th>
          </tr>
        </thead>
        <tbody>
          {
            patients?.length ? (
              patients.map((patient) => (
                <tr class="border-t border-slate-200">
                  <td class="px-3 py-2">
                    {patient.full_name}
                    {!patient.is_active && (
                      <Badge variant="neutral" class="ml-2 align-middle">
                        Inativa
                      </Badge>
                    )}
                  </td>
                  <td class="px-3 py-2 text-slate-500">{formatBirthdate(patient.birthdate)}</td>
                  <td class="px-3 py-2 text-slate-500">{patient.notes ?? "—"}</td>
                  <td class="whitespace-nowrap px-3 py-2 text-right">
                    <div class="flex flex-nowrap justify-end gap-1.5">
                      <a
                        href={`/admin/pacientes/${guardian.id}/criancas/${patient.id}/editar`}
                        class="rounded-md border border-slate-300 px-2.5 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-50"
                      >
                        Editar
                      </a>
                      {patient.is_active ? (
                        <form
                          method="POST"
                          action={`/api/admin/pacientes/${guardian.id}/criancas/${patient.id}/excluir`}
                        >
                          <button
                            type="submit"
                            class="js-confirm-delete rounded-md border border-red-200 px-2.5 py-1.5 text-xs font-medium text-red-700 hover:bg-red-50"
                            data-confirm-message={`Excluir ${patient.full_name}? Fica marcada como inativa — os dados continuam guardados e dá pra reativar depois em "Mostrar inativas".`}
                          >
                            Excluir
                          </button>
                        </form>
                      ) : (
                        <form
                          method="POST"
                          action={`/api/admin/pacientes/${guardian.id}/criancas/${patient.id}/reativar`}
                        >
                          <button
                            type="submit"
                            class="rounded-md border border-slate-300 px-2.5 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-50"
                          >
                            Reativar
                          </button>
                        </form>
                      )}
                    </div>
                  </td>
                </tr>
              ))
            ) : (
              <tr class="border-t border-slate-200">
                <td class="px-3 py-4 text-slate-500" colspan="4">
                  {q ? "Nenhum resultado para essa busca." : "Nenhuma criança cadastrada ainda."}
                </td>
              </tr>
            )
          }
        </tbody>
      </table>
    </div>

    {
      totalPages > 1 && (
        <div class="mt-3 flex items-center justify-between text-sm text-slate-600">
          <span>
            Página {page} de {totalPages}
          </span>
          <div class="flex gap-3">
            {page > 1 && <a href={pageUrl(page - 1)} class="text-sky-700 hover:underline">Anterior</a>}
            {page < totalPages && (
              <a href={pageUrl(page + 1)} class="text-sky-700 hover:underline">
                Próxima
              </a>
            )}
          </div>
        </div>
      )
    }
  </section>

  <ConfirmDeleteDialog />
</AdminLayout>
