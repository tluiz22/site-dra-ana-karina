---
import AdminLayout from "../../../../../../layouts/AdminLayout.astro";
import { createClient } from "../../../../../../lib/supabase/server";

const supabase = createClient(Astro.request, Astro.cookies);
const { id: guardianId, patientId } = Astro.params;

const { data: guardian } = await supabase
  .from("guardians")
  .select("id, full_name")
  .eq("id", guardianId)
  .maybeSingle();

if (!guardian) {
  return Astro.redirect("/admin/pacientes?error=not_found");
}

const { data: patient } = await supabase
  .from("patients")
  .select("id, full_name, birthdate, notes")
  .eq("id", patientId)
  .eq("guardian_id", guardianId)
  .maybeSingle();

if (!patient) {
  return Astro.redirect(`/admin/pacientes/${guardianId}?error=not_found`);
}

const errorMessages: Record<string, string> = {
  invalid_birthdate: "Data de nascimento inválida.",
  "1": "Não foi possível salvar. Confira os dados e tente novamente.",
};
const errorParam = Astro.url.searchParams.get("error");
const errorMessage = errorParam ? (errorMessages[errorParam] ?? errorMessages["1"]) : null;
---

<AdminLayout title={`Editar ${patient.full_name}`}>
  <a href={`/admin/pacientes/${guardian.id}`} class="text-sm text-sky-700 hover:underline">
    &larr; {guardian.full_name}
  </a>

  <h1 class="mt-3 text-2xl font-bold text-slate-900">Editar criança</h1>

  {
    errorMessage && (
      <p class="mt-4 rounded-md bg-red-50 px-3 py-2 text-sm text-red-700">{errorMessage}</p>
    )
  }

  <form
    method="POST"
    action={`/api/admin/pacientes/${guardian.id}/criancas/${patient.id}/editar`}
    class="mt-4 flex max-w-xl flex-col gap-3 rounded-md border border-slate-200 bg-white p-4"
  >
    <div>
      <label for="full_name" class="block text-sm font-medium text-slate-700">Nome</label>
      <input
        type="text"
        id="full_name"
        name="full_name"
        value={patient.full_name}
        required
        class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm"
      />
    </div>
    <div>
      <label for="birthdate" class="block text-sm font-medium text-slate-700">
        Data de nascimento
      </label>
      <input
        type="date"
        id="birthdate"
        name="birthdate"
        value={patient.birthdate}
        min="1900-01-01"
        max={new Date().toISOString().slice(0, 10)}
        required
        class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm"
      />
    </div>
    <div>
      <label for="notes" class="block text-sm font-medium text-slate-700">
        Observação (operacional, não clínica)
      </label>
      <input
        type="text"
        id="notes"
        name="notes"
        value={patient.notes ?? ""}
        class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm"
      />
    </div>
    <button
      type="submit"
      class="mt-2 w-fit rounded-md bg-sky-700 px-4 py-2 text-sm font-medium text-white hover:bg-sky-800"
    >
      Salvar
    </button>
  </form>
</AdminLayout>
