---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import Card from "../../../components/admin/Card.astro";
import Icon from "../../../components/admin/Icon.astro";
import { createClient } from "../../../lib/supabase/server";
import { getExamAvailableSlotsForDate } from "../../../lib/scheduling/getExamAvailableSlotsForDate";
import { getExamNextAvailableDates } from "../../../lib/scheduling/getExamNextAvailableDates";
import { getNextAvailableGroupDates, type AvailableGroupSession } from "../../../lib/scheduling/getNextAvailableGroupDates";
import { formatPhoneBR } from "../../../lib/phone";
import { formatDateOptionLabel } from "../../../lib/dates";

const supabase = createClient(Astro.request, Astro.cookies);

const appointmentId = Astro.url.searchParams.get("appointment_id");

if (!appointmentId) {
  return Astro.redirect("/admin/agenda");
}

const { data: appointment } = await supabase
  .from("appointments")
  .select(
    "id, appointment_type, scheduled_at, status, exam_type_id, patients ( full_name, guardians ( full_name, phone ) ), exam_types ( name, duration_minutes, scheduling_mode )"
  )
  .eq("id", appointmentId)
  .single();

// Não é exame (ou não existe) — manda pra tela certa em vez de mostrar um
// formulário sem sentido.
if (!appointment || !["scheduled", "confirmed"].includes(appointment.status)) {
  return Astro.redirect("/admin/agenda");
}
if (appointment.appointment_type !== "exam") {
  return Astro.redirect(`/admin/agenda/remarcar?appointment_id=${appointmentId}`);
}

const patient = (appointment.patients ?? null) as any;
const guardian = patient?.guardians ?? null;
const examType = appointment.exam_types as unknown as {
  name: string;
  duration_minutes: number;
  scheduling_mode: string;
} | null;
const isGroupExam = examType?.scheduling_mode === "group";

const { data: examLocation } = await supabase
  .from("clinic_locations")
  .select("id")
  .eq("type", "exam")
  .eq("is_active", true)
  .maybeSingle();

function toFortalezaDateStr(iso: string): string {
  return new Date(new Date(iso).getTime() - 3 * 60 * 60 * 1000).toISOString().slice(0, 10);
}

function toFortalezaTimeStr(iso: string): string {
  return new Date(new Date(iso).getTime() - 3 * 60 * 60 * 1000).toISOString().slice(11, 16);
}

function groupSessionStartIso(session: AvailableGroupSession): string {
  return new Date(`${session.date}T${session.startTime}:00-03:00`).toISOString();
}

const currentDateStr = toFortalezaDateStr(appointment.scheduled_at);
const currentTimeStr = toFortalezaTimeStr(appointment.scheduled_at);

const errorMessages: Record<string, string> = {
  slot_taken: "Esse horário acabou de deixar de estar livre. Escolha outro.",
  "1": "Não foi possível remarcar o exame. Confira os dados e tente novamente.",
};
const errorParam = Astro.url.searchParams.get("error");
const errorMessage = errorParam ? (errorMessages[errorParam] ?? errorMessages["1"]) : null;

let availableDates: { date: string; weekday: number }[] = [];
let slots: { start: Date; label: string; clinicLocationId: string }[] = [];
let groupDateOptions: AvailableGroupSession[] = [];
let selectedGroupSession: AvailableGroupSession | undefined;
let date = "";

if (examType && isGroupExam) {
  const sessions = await getNextAvailableGroupDates({ supabase, examTypeId: appointment.exam_type_id ?? "" });
  const seenDates = new Set<string>();
  for (const session of sessions) {
    if (seenDates.has(session.date)) continue;
    seenDates.add(session.date);
    groupDateOptions.push(session);
  }

  const dateParam = Astro.url.searchParams.get("date");
  date = dateParam && groupDateOptions.some((d) => d.date === dateParam)
    ? dateParam
    : groupDateOptions.some((d) => d.date === currentDateStr)
      ? currentDateStr
      : (groupDateOptions[0]?.date ?? "");
  selectedGroupSession = groupDateOptions.find((d) => d.date === date);
} else if (examLocation && examType) {
  availableDates = await getExamNextAvailableDates({
    supabase,
    examTypeId: appointment.exam_type_id ?? "",
    examLocationId: examLocation.id,
    examDurationMinutes: examType.duration_minutes,
  });

  const dateParam = Astro.url.searchParams.get("date");
  date = dateParam && availableDates.some((d) => d.date === dateParam)
    ? dateParam
    : availableDates.some((d) => d.date === currentDateStr)
      ? currentDateStr
      : (availableDates[0]?.date ?? "");

  if (date) {
    slots = await getExamAvailableSlotsForDate({
      supabase,
      examTypeId: appointment.exam_type_id ?? "",
      examLocationId: examLocation.id,
      date,
      examDurationMinutes: examType.duration_minutes,
    });
  }
}
---

<AdminLayout title="Remarcar exame">
  <a
    href={`/admin/agenda?date=${currentDateStr}`}
    class="inline-flex items-center gap-1 text-sm font-medium text-sky-700 hover:underline"
  >
    <Icon name="chevron-left" class="h-4 w-4" />
    Agenda
  </a>

  <h1 class="mt-3 text-2xl font-bold text-slate-900">Remarcar exame</h1>

  <div class="mt-4 rounded-lg border border-slate-200 bg-slate-50 p-4 text-sm text-slate-700">
    <p class="font-medium text-slate-900">{patient?.full_name}</p>
    <p class="text-slate-500">
      Resp.: {guardian?.full_name} · {guardian?.phone && formatPhoneBR(guardian.phone)}
    </p>
    <p class="mt-1 text-slate-500">{examType?.name}</p>
    <p class="mt-1 text-slate-500">
      Atualmente em {currentDateStr.split("-").reverse().join("/")} às {currentTimeStr}
    </p>
  </div>

  {
    errorMessage && (
      <p class="mt-4 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">{errorMessage}</p>
    )
  }

  <Card class="mt-6 max-w-xl">
    <form
      method="POST"
      action={`/api/admin/agenda/appointments/${appointmentId}/reschedule`}
      class="flex flex-col gap-6"
    >
      <input type="hidden" name="appointment_type" value="exam" />
      <input
        type="hidden"
        id="exam_type_id"
        value={appointment.exam_type_id}
        data-scheduling-mode={examType?.scheduling_mode}
      />

      <div>
        <label for="date" class="block text-sm font-medium text-slate-700">Data</label>
        {
          isGroupExam ? (
            <select
              id="date"
              name="date"
              disabled={!groupDateOptions.length}
              class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-sky-600 focus:outline-none focus:ring-1 focus:ring-sky-600 disabled:bg-slate-100 sm:w-auto"
            >
              {groupDateOptions.map((session) => (
                <option
                  value={session.date}
                  selected={session.date === date}
                  data-start={groupSessionStartIso(session)}
                  data-start-label={session.startTime}
                  data-end-label={session.endTime}
                  data-remaining={session.remainingCapacity}
                >
                  {formatDateOptionLabel(session.date)}
                </option>
              ))}
            </select>
          ) : (
            <select
              id="date"
              name="date"
              disabled={!availableDates.length}
              class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-sky-600 focus:outline-none focus:ring-1 focus:ring-sky-600 disabled:bg-slate-100 sm:w-auto"
            >
              {availableDates.map((d) => (
                <option value={d.date} selected={d.date === date}>{formatDateOptionLabel(d.date)}</option>
              ))}
            </select>
          )
        }
        <p
          id="date_availability_warning"
          class={`mt-1 text-xs text-amber-700 ${(isGroupExam ? groupDateOptions.length : availableDates.length) ? "hidden" : ""}`}
        >
          {isGroupExam ? "Nenhuma vaga nos próximos dias." : "Nenhum horário livre para esse exame nos próximos dias."} Fale com a
          secretária pelo WhatsApp.
        </p>
      </div>

      <div>
        <span class="block text-sm font-medium text-slate-700">Novo horário</span>
        <div id="slots_container" class="mt-1 flex flex-wrap gap-2" data-exam-location-id={examLocation?.id ?? ""}>
          {
            isGroupExam ? (
              selectedGroupSession ? (
                <>
                  <p class="text-sm text-slate-600">
                    Esse exame é sempre das {selectedGroupSession.startTime} às {selectedGroupSession.endTime} —
                    escolha só a data. Vagas: {selectedGroupSession.remainingCapacity}.
                  </p>
                  <input
                    type="hidden"
                    name="start"
                    value={`${groupSessionStartIso(selectedGroupSession)}|${examLocation?.id ?? ""}`}
                  />
                </>
              ) : (
                <p class="text-sm text-slate-500">Nenhuma vaga nesse dia. Escolha outra data.</p>
              )
            ) : slots.length ? (
              slots.map((slot) => (
                <label class="cursor-pointer rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 shadow-sm has-[:checked]:border-sky-700 has-[:checked]:bg-sky-50 has-[:checked]:text-sky-700">
                  <input
                    type="radio"
                    name="start"
                    value={`${slot.start.toISOString()}|${slot.clinicLocationId}`}
                    required
                    class="mr-1"
                  />
                  {slot.label}
                </label>
              ))
            ) : (
              <p class="text-sm text-slate-500">
                Nenhum horário livre para essa data/exame. Tente outra data.
              </p>
            )
          }
        </div>
      </div>

      <div class="flex flex-col-reverse gap-2 sm:flex-row sm:items-center">
        <a
          href={`/admin/agenda?date=${currentDateStr}`}
          class="w-full rounded-md border border-slate-300 px-4 py-3 text-center text-sm font-semibold text-slate-600 hover:bg-slate-50 sm:w-fit"
        >
          Cancelar
        </a>
        <button
          id="submit_btn"
          type="submit"
          disabled={isGroupExam ? !groupDateOptions.length : !availableDates.length}
          class="w-full rounded-md bg-sky-700 px-4 py-3 text-sm font-semibold text-white hover:bg-sky-800 disabled:cursor-not-allowed disabled:opacity-50 sm:w-fit"
        >
          Confirmar remarcação
        </button>
      </div>
    </form>
  </Card>
</AdminLayout>

<script src="../../../scripts/examSlotPicker.ts"></script>
