---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import Badge from "../../../components/admin/Badge.astro";
import Icon from "../../../components/admin/Icon.astro";
import { createClient } from "../../../lib/supabase/server";
import { listEvents } from "../../../lib/google/calendar";

const supabase = createClient(Astro.request, Astro.cookies);

function todayFortaleza(): string {
  return new Date(Date.now() - 3 * 60 * 60 * 1000).toISOString().slice(0, 10);
}

function addDays(dateStr: string, delta: number): string {
  const d = new Date(`${dateStr}T12:00:00Z`);
  d.setUTCDate(d.getUTCDate() + delta);
  return d.toISOString().slice(0, 10);
}

function addMonths(dateStr: string, delta: number): string {
  const [year, month] = dateStr.slice(0, 7).split("-").map(Number);
  const totalMonths = year * 12 + (month - 1) + delta;
  const newYear = Math.floor(totalMonths / 12);
  const newMonth = (totalMonths % 12) + 1;
  return `${newYear}-${String(newMonth).padStart(2, "0")}-01`;
}

function daysInMonth(year: number, month: number): number {
  return new Date(Date.UTC(year, month, 0)).getUTCDate();
}

function weekdayOf(dateStr: string): number {
  return new Date(`${dateStr}T00:00:00-03:00`).getUTCDay();
}

function startOfWeek(dateStr: string): string {
  const weekday = weekdayOf(dateStr);
  const mondayOffset = weekday === 0 ? -6 : 1 - weekday;
  return addDays(dateStr, mondayOffset);
}

function fortalezaDateStr(dateTime: string): string {
  return new Date(new Date(dateTime).getTime() - 3 * 60 * 60 * 1000).toISOString().slice(0, 10);
}

const monthNames = [
  "Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho",
  "Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro",
];
const weekdayLabels = ["Seg", "Ter", "Qua", "Qui", "Sex", "Sáb", "Dom"];

const dateParam = Astro.url.searchParams.get("date");
const anchorDate = dateParam && /^\d{4}-\d{2}-\d{2}$/.test(dateParam) ? dateParam : todayFortaleza();
const monthStart = `${anchorDate.slice(0, 7)}-01`;
const [anchorYear, anchorMonthNum] = monthStart.slice(0, 7).split("-").map(Number);
const monthEnd = `${monthStart.slice(0, 7)}-${String(daysInMonth(anchorYear, anchorMonthNum)).padStart(2, "0")}`;

const gridStart = startOfWeek(monthStart);
const gridEnd = addDays(startOfWeek(monthEnd), 6);

const gridDates: string[] = [];
for (let cursor = gridStart; cursor <= gridEnd; cursor = addDays(cursor, 1)) {
  gridDates.push(cursor);
}

const rangeStart = new Date(`${gridStart}T00:00:00-03:00`);
const rangeEnd = new Date(`${addDays(gridEnd, 1)}T00:00:00-03:00`);
const events = await listEvents(rangeStart, rangeEnd);

const appointmentIds = events
  .map((event) => event.extendedProperties?.private?.appointment_id)
  .filter((id): id is string => Boolean(id));

// Consulta/exame são jornadas separadas (set/2026) — a contagem do mês
// mostra as duas separadas, não um número só de "consultas" que na
// verdade mistura os dois tipos.
const { data: appointmentRows } = appointmentIds.length
  ? await supabase.from("appointments").select("id, appointment_type").in("id", appointmentIds)
  : { data: [] as { id: string; appointment_type: string }[] };
const appointmentTypeById = new Map((appointmentRows ?? []).map((a) => [a.id, a.appointment_type]));

const countsByDate = new Map<string, { consultas: number; exames: number; cancelled: number }>();
for (const date of gridDates) countsByDate.set(date, { consultas: 0, exames: 0, cancelled: 0 });
for (const event of events) {
  const dateTime = event.start.dateTime;
  if (!dateTime) continue;
  const appointmentId = event.extendedProperties?.private?.appointment_id;
  if (!appointmentId) continue;
  const entry = countsByDate.get(fortalezaDateStr(dateTime));
  if (!entry) continue;
  if (event.status === "cancelled") {
    entry.cancelled++;
    continue;
  }
  if (appointmentTypeById.get(appointmentId) === "exam") entry.exames++;
  else entry.consultas++;
}

const currentMonthDates = new Set(gridDates.filter((date) => date >= monthStart && date <= monthEnd));

const today = todayFortaleza();
const weeks: string[][] = [];
for (let i = 0; i < gridDates.length; i += 7) weeks.push(gridDates.slice(i, i + 7));
---

<AdminLayout title="Agenda — mês">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Agenda</h1>
      <nav class="mt-3 flex gap-x-5 border-b border-slate-200 text-sm font-medium">
        <a
          href={`/admin/agenda?date=${anchorDate}`}
          class="-mb-px border-b-2 border-transparent pb-2 text-slate-600 hover:text-sky-700"
        >
          Dia
        </a>
        <a
          href={`/admin/agenda/semana?date=${anchorDate}`}
          class="-mb-px border-b-2 border-transparent pb-2 text-slate-600 hover:text-sky-700"
        >
          Semana
        </a>
        <span class="-mb-px border-b-2 border-sky-700 pb-2 text-sky-700">Mês</span>
      </nav>
    </div>

    <div class="flex flex-wrap gap-2">
      <a
        href={`/admin/agenda/marcar?date=${anchorDate}`}
        class="inline-flex items-center gap-1.5 rounded-md bg-sky-700 px-4 py-2 text-sm font-medium text-white hover:bg-sky-800"
      >
        <Icon name="plus" class="h-4 w-4" />
        Marcar consulta
      </a>
      <a
        href={`/admin/agenda/marcar-exame?date=${anchorDate}`}
        class="inline-flex items-center gap-1.5 rounded-md border border-sky-700 px-4 py-2 text-sm font-medium text-sky-700 hover:bg-sky-50"
      >
        <Icon name="plus" class="h-4 w-4" />
        Marcar exame
      </a>
    </div>
  </div>

  <div class="mt-6 flex items-center justify-between gap-2 rounded-lg border border-slate-200 bg-white p-2">
    <a
      href={`/admin/agenda/mes?date=${addMonths(monthStart, -1)}`}
      aria-label="Mês anterior"
      class="rounded-md p-2 text-slate-500 hover:bg-slate-100 hover:text-sky-700"
    >
      <Icon name="chevron-left" class="h-5 w-5" />
    </a>
    <div class="flex flex-wrap items-center justify-center gap-2">
      <p class="text-sm font-medium text-slate-900">
        {monthNames[anchorMonthNum - 1]} de {anchorYear}
      </p>
      {
        monthStart !== `${today.slice(0, 7)}-01` && (
          <a
            href="/admin/agenda/mes"
            class="rounded-md border border-slate-300 px-2.5 py-1 text-xs font-medium text-slate-600 hover:bg-slate-50"
          >
            Mês atual
          </a>
        )
      }
    </div>
    <a
      href={`/admin/agenda/mes?date=${addMonths(monthStart, 1)}`}
      aria-label="Próximo mês"
      class="rounded-md p-2 text-slate-500 hover:bg-slate-100 hover:text-sky-700"
    >
      <Icon name="chevron-right" class="h-5 w-5" />
    </a>
  </div>

  <div class="mt-6 overflow-x-auto">
    <div class="grid min-w-[640px] grid-cols-7 gap-1.5">
      {
        weekdayLabels.map((label) => (
          <div class="px-1 pb-1 text-center text-xs font-medium uppercase tracking-wide text-slate-500">
            {label}
          </div>
        ))
      }
      {
        weeks.flatMap((week) =>
          week.map((date) => {
            const inCurrentMonth = currentMonthDates.has(date);
            const isToday = date === today;
            const counts = countsByDate.get(date) ?? { consultas: 0, exames: 0, cancelled: 0 };
            const dayNumber = Number(date.slice(8, 10));

            return (
              <a
                href={`/admin/agenda?date=${date}`}
                class={`flex min-h-[76px] flex-col gap-1 rounded-lg border p-2 shadow-sm hover:bg-slate-50 ${
                  isToday
                    ? "border-sky-400 bg-sky-50/40"
                    : inCurrentMonth
                      ? "border-slate-200 bg-white"
                      : "border-slate-100 bg-slate-50 shadow-none"
                }`}
              >
                <span class={`text-sm ${inCurrentMonth ? "text-slate-900" : "text-slate-400"}`}>{dayNumber}</span>
                {counts.consultas > 0 && (
                  <Badge variant="info" class="w-fit">
                    {counts.consultas} {counts.consultas === 1 ? "consulta" : "consultas"}
                  </Badge>
                )}
                {counts.exames > 0 && (
                  <Badge variant="warning" class="w-fit">
                    {counts.exames} {counts.exames === 1 ? "exame" : "exames"}
                  </Badge>
                )}
                {counts.cancelled > 0 && (
                  <Badge variant="neutral" class="w-fit">
                    {counts.cancelled} cancelada{counts.cancelled === 1 ? "" : "s"}
                  </Badge>
                )}
              </a>
            );
          })
        )
      }
    </div>
  </div>
</AdminLayout>
