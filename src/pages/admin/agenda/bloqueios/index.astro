---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import Card from "../../../../components/admin/Card.astro";
import Icon from "../../../../components/admin/Icon.astro";
import ConfirmDeleteDialog from "../../../../components/admin/ConfirmDeleteDialog.astro";
import { listEvents } from "../../../../lib/google/calendar";

function todayFortaleza(): string {
  return new Date(Date.now() - 3 * 60 * 60 * 1000).toISOString().slice(0, 10);
}

function addDaysStr(dateStr: string, delta: number): string {
  const d = new Date(`${dateStr}T12:00:00Z`);
  d.setUTCDate(d.getUTCDate() + delta);
  return d.toISOString().slice(0, 10);
}

function toFortaleza(dateTime: string): Date {
  return new Date(new Date(dateTime).getTime() - 3 * 60 * 60 * 1000);
}

function formatShortDate(dateStr: string): string {
  const [, month, day] = dateStr.split("-");
  return `${day}/${month}`;
}

// Cobre os próximos 6 meses — janela generosa pro caso comum (bloqueio
// pontual ou férias planejadas com alguma antecedência), sem carregar o
// Calendar inteiro (que tem também todos os atendimentos, não só bloqueios).
const today = todayFortaleza();
const rangeStart = new Date(`${today}T00:00:00-03:00`);
const rangeEnd = new Date(rangeStart.getTime() + 180 * 24 * 60 * 60_000);

const events = await listEvents(rangeStart, rangeEnd);

const blocks = events
  .filter((event) => event.extendedProperties?.private?.admin_block === "true" && event.status !== "cancelled")
  .sort((a, b) => new Date(a.start.dateTime ?? 0).getTime() - new Date(b.start.dateTime ?? 0).getTime());

function formatBlockPeriod(startIso: string | undefined, endIso: string | undefined): string {
  if (!startIso || !endIso) return "—";
  const startLocal = toFortaleza(startIso);
  const endLocal = toFortaleza(endIso);
  const startDateStr = startLocal.toISOString().slice(0, 10);
  const endDateStr = endLocal.toISOString().slice(0, 10);
  const startTimeStr = startLocal.toISOString().slice(11, 16);
  const endTimeStr = endLocal.toISOString().slice(11, 16);
  const isFullDay = startTimeStr === "00:00" && endTimeStr === "00:00";

  if (isFullDay) {
    const lastDayStr = addDaysStr(endDateStr, -1);
    return lastDayStr === startDateStr
      ? `Dia inteiro — ${formatShortDate(startDateStr)}`
      : `Dia inteiro — ${formatShortDate(startDateStr)} a ${formatShortDate(lastDayStr)}`;
  }

  return startDateStr === endDateStr
    ? `${formatShortDate(startDateStr)}, ${startTimeStr}–${endTimeStr}`
    : `${formatShortDate(startDateStr)} ${startTimeStr} – ${formatShortDate(endDateStr)} ${endTimeStr}`;
}
---

<AdminLayout title="Bloqueios de agenda">
  <a
    href={`/admin/agenda?date=${today}`}
    class="inline-flex items-center gap-1 text-sm font-medium text-sky-700 hover:underline"
  >
    <Icon name="chevron-left" class="h-4 w-4" />
    Agenda
  </a>

  <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-bold text-slate-900">Bloqueios de agenda</h1>
    <a
      href="/admin/agenda/bloquear"
      class="inline-flex items-center gap-1.5 rounded-md bg-sky-700 px-4 py-2 text-sm font-medium text-white hover:bg-sky-800"
    >
      <Icon name="plus" class="h-4 w-4" />
      Novo bloqueio
    </a>
  </div>
  <p class="mt-1 text-sm text-slate-600">Mostra os bloqueios ativos dos próximos 6 meses.</p>

  <div class="mt-6 flex flex-col gap-3">
    {
      blocks.length ? (
        blocks.map((event) => (
          <Card>
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="text-sm font-semibold text-slate-900">
                {formatBlockPeriod(event.start.dateTime, event.end.dateTime)}
              </span>
            </div>
            {event.description && <p class="mt-2 text-sm text-slate-600">{event.description}</p>}
            <div class="mt-3 flex gap-2">
              <a
                href={`/admin/agenda/bloqueios/${event.id}/editar`}
                class="flex-1 rounded-md border border-sky-300 px-3 py-2 text-center text-xs font-semibold text-sky-700 hover:bg-sky-50 sm:flex-none"
              >
                Editar
              </a>
              <form method="POST" action={`/api/admin/agenda/bloqueios/${event.id}/remover`} class="flex-1 sm:flex-none">
                <button
                  type="submit"
                  class="js-confirm-delete w-full rounded-md border border-red-300 px-3 py-2 text-xs font-semibold text-red-700 hover:bg-red-50"
                  data-confirm-message="Remover esse bloqueio? O horário volta a ficar livre na agenda."
                >
                  Remover
                </button>
              </form>
            </div>
          </Card>
        ))
      ) : (
        <Card class="text-center text-slate-500">Nenhum bloqueio ativo nos próximos 6 meses.</Card>
      )
    }
  </div>

  <ConfirmDeleteDialog />
</AdminLayout>
