---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import Card from "../../../components/admin/Card.astro";
import Icon from "../../../components/admin/Icon.astro";

function todayFortaleza(): string {
  return new Date(Date.now() - 3 * 60 * 60 * 1000).toISOString().slice(0, 10);
}

const today = todayFortaleza();
---

<AdminLayout title="Bloquear agenda">
  <a
    href={`/admin/agenda?date=${today}`}
    class="inline-flex items-center gap-1 text-sm font-medium text-sky-700 hover:underline"
  >
    <Icon name="chevron-left" class="h-4 w-4" />
    Agenda
  </a>

  <h1 class="mt-3 text-2xl font-bold text-slate-900">Bloquear agenda</h1>
  <p class="mt-1 text-sm text-slate-600">
    Cria um bloqueio de verdade no Google Calendar — aparece também pra quem olha só pelo app do celular. Se já
    houver atendimentos marcados no período, perguntamos o que fazer antes de confirmar. Por enquanto, editar ou
    remover um bloqueio já criado ainda é feito direto pelo app do Google Calendar.
  </p>

  <p id="form_error" class="mt-4 hidden rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
    Não foi possível criar o bloqueio. Confira os dados e tente novamente.
  </p>

  <Card class="mt-6 max-w-xl">
    <form id="block_form" class="flex flex-col gap-6">
      <label class="flex items-center gap-2 text-sm font-medium text-slate-700">
        <input
          type="checkbox"
          id="full_day"
          name="full_day"
          class="h-4 w-4 rounded border-slate-300 text-sky-700 focus:ring-sky-600"
        />
        Bloquear o dia todo (não precisa preencher hora)
      </label>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <label for="start_date" class="block text-sm font-medium text-slate-700">Início — data *</label>
          <input
            type="date"
            id="start_date"
            name="start_date"
            required
            min={today}
            class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-sky-600 focus:outline-none focus:ring-1 focus:ring-sky-600"
          />
        </div>
        <div id="start_time_field">
          <label for="start_time" class="block text-sm font-medium text-slate-700">Início — hora *</label>
          <input
            type="time"
            id="start_time"
            name="start_time"
            required
            class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-sky-600 focus:outline-none focus:ring-1 focus:ring-sky-600"
          />
        </div>
        <div>
          <label for="end_date" class="block text-sm font-medium text-slate-700">Fim — data *</label>
          <input
            type="date"
            id="end_date"
            name="end_date"
            required
            min={today}
            class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-sky-600 focus:outline-none focus:ring-1 focus:ring-sky-600"
          />
        </div>
        <div id="end_time_field">
          <label for="end_time" class="block text-sm font-medium text-slate-700">Fim — hora *</label>
          <input
            type="time"
            id="end_time"
            name="end_time"
            required
            class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-sky-600 focus:outline-none focus:ring-1 focus:ring-sky-600"
          />
        </div>
      </div>
      <p class="text-xs text-slate-500">
        Pra bloquear vários dias seguidos (ex.: férias), escolha o dia todo e preencha início e fim com datas
        diferentes.
      </p>

      <div>
        <label for="motivo" class="block text-sm font-medium text-slate-700">Motivo *</label>
        <textarea
          id="motivo"
          name="motivo"
          required
          rows={3}
          placeholder="Ex.: imprevisto da médica, férias, feriado"
          class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-sky-600 focus:outline-none focus:ring-1 focus:ring-sky-600"
        ></textarea>
        <p class="mt-1 text-xs text-slate-500">Aparece na Agenda e no evento criado no Google Calendar.</p>
      </div>

      <div class="flex flex-col-reverse gap-2 sm:flex-row sm:items-center">
        <a
          href={`/admin/agenda?date=${today}`}
          class="w-full rounded-md border border-slate-300 px-4 py-3 text-center text-sm font-semibold text-slate-600 hover:bg-slate-50 sm:w-fit"
        >
          Cancelar
        </a>
        <button
          id="submit_btn"
          type="submit"
          class="w-full rounded-md bg-sky-700 px-4 py-3 text-sm font-semibold text-white hover:bg-sky-800 disabled:cursor-not-allowed disabled:opacity-50 sm:w-fit"
        >
          Confirmar bloqueio
        </button>
      </div>
    </form>
  </Card>

  <!-- Fase 13 etapa 2: aparece só quando há atendimentos marcados dentro do
       período escolhido — pergunta o que fazer com eles antes de criar o
       bloqueio de verdade. -->
  <dialog
    id="conflict_dialog"
    class="w-[calc(100%-2rem)] max-w-sm rounded-lg border border-slate-200 bg-white p-0 shadow-xl backdrop:bg-slate-900/40"
  >
    <div class="p-5">
      <h2 class="text-base font-semibold text-slate-900">
        Há <span id="conflict_dialog_count">0</span> atendimento(s) nesse período
      </h2>
      <ul id="conflict_dialog_list" class="mt-2 max-h-40 list-disc space-y-1 overflow-y-auto pl-5 text-sm text-slate-700"></ul>
      <p class="mt-3 text-sm text-slate-600">O que deseja fazer com eles?</p>
      <p id="conflict_dialog_error" class="mt-2 hidden text-sm text-red-700">
        Não foi possível concluir. Tente novamente.
      </p>
      <div class="mt-5 flex flex-col gap-2">
        <button
          type="button"
          id="conflict_cancel_all_btn"
          class="rounded-md bg-red-600 px-3 py-2 text-sm font-medium text-white hover:bg-red-700 disabled:cursor-not-allowed disabled:opacity-50"
        >
          Cancelar atendimentos e bloquear
        </button>
        <button
          type="button"
          id="conflict_keep_btn"
          class="rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50"
        >
          Manter atendimentos, só bloquear o resto
        </button>
        <button
          type="button"
          id="conflict_dialog_dismiss"
          class="rounded-md px-3 py-2 text-sm font-medium text-slate-500 hover:bg-slate-50"
        >
          Voltar sem bloquear
        </button>
      </div>
    </div>
  </dialog>
</AdminLayout>

<script>
  const fullDayCheckbox = document.getElementById("full_day") as HTMLInputElement;
  const startTimeField = document.getElementById("start_time_field") as HTMLDivElement;
  const endTimeField = document.getElementById("end_time_field") as HTMLDivElement;
  const startTimeInput = document.getElementById("start_time") as HTMLInputElement;
  const endTimeInput = document.getElementById("end_time") as HTMLInputElement;

  function applyFullDayState() {
    const fullDay = fullDayCheckbox.checked;
    startTimeField.classList.toggle("hidden", fullDay);
    endTimeField.classList.toggle("hidden", fullDay);
    startTimeInput.required = !fullDay;
    endTimeInput.required = !fullDay;
  }

  fullDayCheckbox.addEventListener("change", applyFullDayState);
  applyFullDayState();

  const form = document.getElementById("block_form") as HTMLFormElement;
  const submitBtn = document.getElementById("submit_btn") as HTMLButtonElement;
  const formError = document.getElementById("form_error") as HTMLParagraphElement;

  const conflictDialog = document.getElementById("conflict_dialog") as HTMLDialogElement;
  const conflictCount = document.getElementById("conflict_dialog_count") as HTMLSpanElement;
  const conflictList = document.getElementById("conflict_dialog_list") as HTMLUListElement;
  const conflictError = document.getElementById("conflict_dialog_error") as HTMLParagraphElement;
  const conflictCancelAllBtn = document.getElementById("conflict_cancel_all_btn") as HTMLButtonElement;
  const conflictKeepBtn = document.getElementById("conflict_keep_btn") as HTMLButtonElement;
  const conflictDismissBtn = document.getElementById("conflict_dialog_dismiss") as HTMLButtonElement;

  function payload(extra: Record<string, unknown> = {}) {
    const fullDay = fullDayCheckbox.checked;
    return {
      start_date: (document.getElementById("start_date") as HTMLInputElement).value,
      start_time: fullDay ? "00:00" : startTimeInput.value,
      end_date: (document.getElementById("end_date") as HTMLInputElement).value,
      end_time: fullDay ? "00:00" : endTimeInput.value,
      full_day: fullDay,
      motivo: (document.getElementById("motivo") as HTMLTextAreaElement).value,
      ...extra,
    };
  }

  async function submitBlock(extra: Record<string, unknown> = {}) {
    const response = await fetch("/api/admin/agenda/bloqueios", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload(extra)),
    });
    const result = await response.json().catch(() => ({}));
    return { ok: response.ok, result };
  }

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    formError.classList.add("hidden");
    submitBtn.disabled = true;
    submitBtn.textContent = "Verificando…";

    const { ok, result } = await submitBlock();

    if (ok && result.conflict) {
      submitBtn.disabled = false;
      submitBtn.textContent = "Confirmar bloqueio";
      conflictCount.textContent = String(result.count);
      conflictList.innerHTML = "";
      for (const appointment of result.appointments as { label: string }[]) {
        const li = document.createElement("li");
        li.textContent = appointment.label;
        conflictList.appendChild(li);
      }
      conflictError.classList.add("hidden");
      conflictCancelAllBtn.disabled = false;
      conflictCancelAllBtn.textContent = "Cancelar atendimentos e bloquear";
      conflictKeepBtn.disabled = false;
      conflictKeepBtn.textContent = "Manter atendimentos, só bloquear o resto";
      conflictDialog.showModal();
      return;
    }

    if (ok && result.ok) {
      window.location.href = result.redirectTo;
      return;
    }

    submitBtn.disabled = false;
    submitBtn.textContent = "Confirmar bloqueio";
    formError.classList.remove("hidden");
  });

  conflictDismissBtn.addEventListener("click", () => conflictDialog.close());
  conflictDialog.addEventListener("click", (event) => {
    if (event.target === conflictDialog) conflictDialog.close();
  });

  async function finalize(cancelConflicts: boolean, button: HTMLButtonElement, busyText: string, idleText: string) {
    conflictCancelAllBtn.disabled = true;
    conflictKeepBtn.disabled = true;
    button.textContent = busyText;
    conflictError.classList.add("hidden");

    const { ok, result } = await submitBlock({ cancel_conflicts: cancelConflicts });

    if (ok && result.ok) {
      window.location.href = result.redirectTo;
      return;
    }

    conflictCancelAllBtn.disabled = false;
    conflictKeepBtn.disabled = false;
    button.textContent = idleText;
    conflictError.classList.remove("hidden");
  }

  conflictCancelAllBtn.addEventListener("click", () =>
    finalize(true, conflictCancelAllBtn, "Cancelando e bloqueando…", "Cancelar atendimentos e bloquear")
  );
  conflictKeepBtn.addEventListener("click", () =>
    finalize(false, conflictKeepBtn, "Bloqueando…", "Manter atendimentos, só bloquear o resto")
  );
</script>
