---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { createClient } from "../../../lib/supabase/server";
import { getAvailableSlotsForDate, type AppointmentType } from "../../../lib/scheduling/getAvailableSlotsForDate";

const supabase = createClient(Astro.request, Astro.cookies);

const appointmentId = Astro.url.searchParams.get("appointment_id");

if (!appointmentId) {
  return Astro.redirect("/admin/agenda");
}

const { data: appointment } = await supabase
  .from("appointments")
  .select(
    "id, appointment_type, clinic_location_id, scheduled_at, status, patients ( full_name, guardians ( full_name, phone ) )"
  )
  .eq("id", appointmentId)
  .single();

if (!appointment || !["scheduled", "confirmed"].includes(appointment.status)) {
  return Astro.redirect("/admin/agenda");
}

const patient = (appointment.patients ?? null) as any;
const guardian = patient?.guardians ?? null;

const { data: clinicLocations } = await supabase
  .from("clinic_locations")
  .select("id, name, type")
  .eq("is_active", true)
  .order("type");

const { data: availabilityWindows } = await supabase
  .from("availability_windows")
  .select("clinic_location_id, weekday")
  .eq("is_active", true);

const availableWeekdaysByLocation: Record<string, number[]> = {};
for (const window of availabilityWindows ?? []) {
  const key = window.clinic_location_id as string;
  const weekdays = (availableWeekdaysByLocation[key] ??= []);
  if (!weekdays.includes(window.weekday)) weekdays.push(window.weekday);
}

function todayFortaleza(): string {
  return new Date(Date.now() - 3 * 60 * 60 * 1000).toISOString().slice(0, 10);
}

function toFortalezaDateStr(iso: string): string {
  return new Date(new Date(iso).getTime() - 3 * 60 * 60 * 1000).toISOString().slice(0, 10);
}

function toFortalezaTimeStr(iso: string): string {
  return new Date(new Date(iso).getTime() - 3 * 60 * 60 * 1000).toISOString().slice(11, 16);
}

const currentDateStr = toFortalezaDateStr(appointment.scheduled_at);
const currentTimeStr = toFortalezaTimeStr(appointment.scheduled_at);

const dateParam = Astro.url.searchParams.get("date");
const isValidDateParam = dateParam && /^\d{4}-\d{2}-\d{2}$/.test(dateParam) && dateParam >= todayFortaleza();
const date = isValidDateParam ? dateParam : currentDateStr >= todayFortaleza() ? currentDateStr : todayFortaleza();

const clinicLocationId =
  Astro.url.searchParams.get("clinic_location_id") || appointment.clinic_location_id || clinicLocations?.[0]?.id || "";

const appointmentTypeParam = Astro.url.searchParams.get("appointment_type");
const appointmentType: AppointmentType =
  appointmentTypeParam === "first_visit" || appointmentTypeParam === "return_visit"
    ? appointmentTypeParam
    : (appointment.appointment_type as AppointmentType);

const errorMessages: Record<string, string> = {
  slot_taken: "Esse horário acabou de deixar de estar livre. Escolha outro.",
  "1": "Não foi possível remarcar a consulta. Confira os dados e tente novamente.",
};
const errorParam = Astro.url.searchParams.get("error");
const errorMessage = errorParam ? (errorMessages[errorParam] ?? errorMessages["1"]) : null;

const slots = clinicLocationId
  ? await getAvailableSlotsForDate({ supabase, clinicLocationId, date, appointmentType })
  : [];
---

<AdminLayout title="Remarcar consulta">
  <a href={`/admin/agenda?date=${currentDateStr}`} class="text-sm text-sky-700 hover:underline">&larr; Agenda</a>

  <h1 class="mt-3 text-2xl font-bold text-slate-900">Remarcar consulta</h1>

  <div class="mt-4 rounded-md border border-slate-200 bg-slate-50 p-4 text-sm text-slate-700">
    <p class="font-medium">{patient?.full_name}</p>
    <p class="text-slate-500">
      Resp.: {guardian?.full_name} · {guardian?.phone}
    </p>
    <p class="mt-1 text-slate-500">
      Atualmente em {currentDateStr.split("-").reverse().join("/")} às {currentTimeStr}
    </p>
  </div>

  {
    errorMessage && (
      <p class="mt-4 rounded-md bg-red-50 px-3 py-2 text-sm text-red-700">{errorMessage}</p>
    )
  }

  <form
    method="POST"
    action={`/api/admin/agenda/appointments/${appointmentId}/reschedule`}
    class="mt-6 flex max-w-xl flex-col gap-6"
  >
    <div class="flex flex-wrap items-end gap-3">
      <div>
        <label for="clinic_location_id" class="block text-sm font-medium text-slate-700">Local</label>
        <select
          id="clinic_location_id"
          name="clinic_location_id"
          class="mt-1 rounded-md border border-slate-300 px-3 py-2 text-sm"
        >
          {
            clinicLocations?.map((location) => (
              <option value={location.id} selected={location.id === clinicLocationId}>
                {location.type === "clinic" ? "Consultório" : "Atendimento domiciliar"} — {location.name}
              </option>
            ))
          }
        </select>
      </div>
      <div>
        <label for="date" class="block text-sm font-medium text-slate-700">Data</label>
        <input
          type="date"
          id="date"
          name="date"
          value={date}
          min={todayFortaleza()}
          class="mt-1 rounded-md border border-slate-300 px-3 py-2 text-sm"
        />
        <p id="date_availability_warning" class="mt-1 hidden text-xs text-amber-700"></p>
      </div>
      <div>
        <label for="appointment_type" class="block text-sm font-medium text-slate-700">Tipo</label>
        <select
          id="appointment_type"
          name="appointment_type"
          class="mt-1 rounded-md border border-slate-300 px-3 py-2 text-sm"
        >
          <option value="first_visit" selected={appointmentType === "first_visit"}>Primeira consulta</option>
          <option value="return_visit" selected={appointmentType === "return_visit"}>Retorno</option>
        </select>
      </div>
    </div>

    <div>
      <span class="block text-sm font-medium text-slate-700">Novo horário</span>
      <div id="slots_container" class="mt-1 flex flex-wrap gap-2">
        {
          slots.length ? (
            slots.map((slot) => (
              <label class="cursor-pointer rounded-md border border-slate-300 px-3 py-2 text-sm has-[:checked]:border-sky-700 has-[:checked]:bg-sky-50">
                <input type="radio" name="start" value={slot.start.toISOString()} required class="mr-1" />
                {slot.label}
              </label>
            ))
          ) : (
            <p class="text-sm text-slate-500">
              Nenhum horário livre para essa data/local. Tente outra data.
            </p>
          )
        }
      </div>
    </div>

    <button
      id="submit_btn"
      type="submit"
      class="w-fit rounded-md bg-sky-700 px-4 py-2 text-sm font-medium text-white hover:bg-sky-800 disabled:cursor-not-allowed disabled:opacity-50"
    >
      Confirmar remarcação
    </button>
  </form>
</AdminLayout>

<script define:vars={{ availableWeekdaysByLocation }} is:inline>
  window.__availableWeekdaysByLocation = availableWeekdaysByLocation;
</script>
<script src="../../../scripts/appointmentSlotPicker.ts"></script>
