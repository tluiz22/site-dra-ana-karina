---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { createClient } from "../../../lib/supabase/server";
import { getAvailableSlotsForDate, type AppointmentType } from "../../../lib/scheduling/getAvailableSlotsForDate";

const supabase = createClient(Astro.request, Astro.cookies);

const { data: clinicLocations } = await supabase
  .from("clinic_locations")
  .select("id, name, type")
  .eq("is_active", true)
  .order("type");

function todayFortaleza(): string {
  return new Date(Date.now() - 3 * 60 * 60 * 1000).toISOString().slice(0, 10);
}

const dateParam = Astro.url.searchParams.get("date");
const date = dateParam && /^\d{4}-\d{2}-\d{2}$/.test(dateParam) ? dateParam : todayFortaleza();

const clinicLocationId =
  Astro.url.searchParams.get("clinic_location_id") || clinicLocations?.[0]?.id || "";

const appointmentType: AppointmentType =
  Astro.url.searchParams.get("appointment_type") === "return_visit" ? "return_visit" : "first_visit";

const errorMessages: Record<string, string> = {
  slot_taken: "Esse horário acabou de deixar de estar livre. Escolha outro.",
  patient_already_scheduled:
    "Esse paciente já tem uma consulta futura marcada. Cancele ou remarque a existente antes de criar uma nova.",
  "1": "Não foi possível marcar a consulta. Confira os dados e tente novamente.",
};
const errorParam = Astro.url.searchParams.get("error");
const errorMessage = errorParam ? (errorMessages[errorParam] ?? errorMessages["1"]) : null;

const slots = clinicLocationId
  ? await getAvailableSlotsForDate({ supabase, clinicLocationId, date, appointmentType })
  : [];
---

<AdminLayout title="Marcar consulta">
  <a href={`/admin/agenda?date=${date}`} class="text-sm text-sky-700 hover:underline">&larr; Agenda</a>

  <h1 class="mt-3 text-2xl font-bold text-slate-900">Marcar consulta</h1>

  {
    errorMessage && (
      <p class="mt-4 rounded-md bg-red-50 px-3 py-2 text-sm text-red-700">{errorMessage}</p>
    )
  }

  <form method="POST" action="/api/admin/agenda/appointments" class="mt-6 flex max-w-xl flex-col gap-6">
    <div class="flex flex-wrap items-end gap-3">
      <div>
        <label for="clinic_location_id" class="block text-sm font-medium text-slate-700">Local</label>
        <select
          id="clinic_location_id"
          name="clinic_location_id"
          class="mt-1 rounded-md border border-slate-300 px-3 py-2 text-sm"
        >
          {
            clinicLocations?.map((location) => (
              <option value={location.id} selected={location.id === clinicLocationId}>
                {location.type === "clinic" ? "Consultório" : "Atendimento domiciliar"} — {location.name}
              </option>
            ))
          }
        </select>
      </div>
      <div>
        <label for="date" class="block text-sm font-medium text-slate-700">Data</label>
        <input
          type="date"
          id="date"
          name="date"
          value={date}
          class="mt-1 rounded-md border border-slate-300 px-3 py-2 text-sm"
        />
      </div>
      <div>
        <label for="appointment_type" class="block text-sm font-medium text-slate-700">Tipo</label>
        <select
          id="appointment_type"
          name="appointment_type"
          class="mt-1 rounded-md border border-slate-300 px-3 py-2 text-sm"
        >
          <option value="first_visit" selected={appointmentType === "first_visit"}>Primeira consulta</option>
          <option value="return_visit" selected={appointmentType === "return_visit"}>Retorno</option>
        </select>
      </div>
    </div>

    <div>
      <label for="patient_search" class="block text-sm font-medium text-slate-700">Paciente</label>
      <input
        type="text"
        id="patient_search"
        autocomplete="off"
        placeholder="Buscar pelo nome da criança ou telefone do responsável"
        class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm"
      />
      <input type="hidden" id="patient_id" name="patient_id" required />
      <div id="patient_results" class="mt-1 flex flex-col overflow-hidden rounded-md border border-slate-200 empty:hidden empty:border-0"></div>
      <p id="patient_warning" class="mt-1 hidden text-xs text-amber-700"></p>
      <p class="mt-1 text-xs text-slate-500">
        Não encontrou?{" "}
        <a href="/admin/pacientes" target="_blank" class="text-sky-700 hover:underline">
          Cadastrar novo paciente
        </a>{" "}
        (abre em outra aba).
      </p>
    </div>

    <div>
      <span class="block text-sm font-medium text-slate-700">Horário</span>
      <div id="slots_container" class="mt-1 flex flex-wrap gap-2">
        {
          slots.length ? (
            slots.map((slot) => (
              <label class="cursor-pointer rounded-md border border-slate-300 px-3 py-2 text-sm has-[:checked]:border-sky-700 has-[:checked]:bg-sky-50">
                <input type="radio" name="start" value={slot.start.toISOString()} required class="mr-1" />
                {slot.label}
              </label>
            ))
          ) : (
            <p class="text-sm text-slate-500">
              Nenhum horário livre para essa data/local. Tente outra data.
            </p>
          )
        }
      </div>
    </div>

    <button
      type="submit"
      class="w-fit rounded-md bg-sky-700 px-4 py-2 text-sm font-medium text-white hover:bg-sky-800"
    >
      Confirmar agendamento
    </button>
  </form>
</AdminLayout>

<script>
  const searchInput = document.getElementById("patient_search") as HTMLInputElement;
  const hiddenInput = document.getElementById("patient_id") as HTMLInputElement;
  const resultsBox = document.getElementById("patient_results") as HTMLDivElement;
  const warningBox = document.getElementById("patient_warning") as HTMLParagraphElement;
  let debounceTimer: ReturnType<typeof setTimeout>;

  searchInput.addEventListener("input", () => {
    hiddenInput.value = "";
    warningBox.classList.add("hidden");
    clearTimeout(debounceTimer);
    const q = searchInput.value.trim();

    if (q.length < 2) {
      resultsBox.innerHTML = "";
      return;
    }

    debounceTimer = setTimeout(async () => {
      const response = await fetch(`/api/admin/pacientes/search?q=${encodeURIComponent(q)}`);
      const patients = await response.json();
      resultsBox.innerHTML = "";

      patients.forEach(
        (patient: {
          id: string;
          full_name: string;
          guardian_name: string;
          guardian_phone: string;
          has_upcoming_appointment: boolean;
        }) => {
          const item = document.createElement("button");
          item.type = "button";
          item.className =
            "block w-full border-t border-slate-100 px-3 py-2 text-left text-sm first:border-t-0 hover:bg-slate-100";
          const label = `${patient.full_name} — resp. ${patient.guardian_name} (${patient.guardian_phone})`;
          item.textContent = patient.has_upcoming_appointment ? `${label} ⚠ já tem consulta futura` : label;
          item.addEventListener("click", () => {
            hiddenInput.value = patient.id;
            searchInput.value = label;
            resultsBox.innerHTML = "";
            if (patient.has_upcoming_appointment) {
              warningBox.textContent =
                "Este paciente já tem uma consulta futura marcada — confirmar aqui vai ser bloqueado até essa ser cancelada/remarcada.";
              warningBox.classList.remove("hidden");
            } else {
              warningBox.classList.add("hidden");
            }
          });
          resultsBox.appendChild(item);
        }
      );
    }, 300);
  });

  const locationSelect = document.getElementById("clinic_location_id") as HTMLSelectElement;
  const dateInput = document.getElementById("date") as HTMLInputElement;
  const typeSelect = document.getElementById("appointment_type") as HTMLSelectElement;
  const slotsContainer = document.getElementById("slots_container") as HTMLDivElement;

  async function refreshSlots() {
    if (!locationSelect.value || !dateInput.value) return;

    slotsContainer.innerHTML = '<p class="text-sm text-slate-500">Carregando horários…</p>';

    const params = new URLSearchParams({
      clinic_location_id: locationSelect.value,
      date: dateInput.value,
      appointment_type: typeSelect.value,
    });

    const response = await fetch(`/api/admin/agenda/available-slots?${params.toString()}`);
    const { slots } = await response.json();
    slotsContainer.innerHTML = "";

    if (!slots.length) {
      slotsContainer.innerHTML =
        '<p class="text-sm text-slate-500">Nenhum horário livre para essa data/local. Tente outra data.</p>';
      return;
    }

    slots.forEach((slot: { start: string; label: string }) => {
      const label = document.createElement("label");
      label.className =
        "cursor-pointer rounded-md border border-slate-300 px-3 py-2 text-sm has-[:checked]:border-sky-700 has-[:checked]:bg-sky-50";
      const input = document.createElement("input");
      input.type = "radio";
      input.name = "start";
      input.value = slot.start;
      input.required = true;
      input.className = "mr-1";
      label.appendChild(input);
      label.append(slot.label);
      slotsContainer.appendChild(label);
    });
  }

  locationSelect.addEventListener("change", refreshSlots);
  dateInput.addEventListener("change", refreshSlots);
  typeSelect.addEventListener("change", refreshSlots);
</script>
