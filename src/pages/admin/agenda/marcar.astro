---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import Card from "../../../components/admin/Card.astro";
import Icon from "../../../components/admin/Icon.astro";
import { createClient } from "../../../lib/supabase/server";
import { getAvailableSlotsForDate, type AppointmentType } from "../../../lib/scheduling/getAvailableSlotsForDate";
import { resolveClinicLocationIds, type LocationCategory } from "../../../lib/scheduling/resolveClinicLocationIds";

const supabase = createClient(Astro.request, Astro.cookies);

// Local vira categoria ("Consultório"/"Atendimento domiciliar"), não um
// endereço físico específico — pode haver mais de um consultório type=
// 'clinic' (2 endereços, set/2026); o horário escolhido é que decide qual
// deles atende (ver "Backlog futuro — Múltiplos consultórios" no plano).
const { data: locationRows } = await supabase.from("clinic_locations").select("id, type").eq("is_active", true);

const categoryOptions: { value: LocationCategory; label: string }[] = [];
if (locationRows?.some((l) => l.type === "clinic")) categoryOptions.push({ value: "clinic", label: "Consultório" });
if (locationRows?.some((l) => l.type === "home_visit")) {
  categoryOptions.push({ value: "home_visit", label: "Atendimento domiciliar" });
}

const { data: availabilityWindows } = await supabase
  .from("availability_windows")
  .select("clinic_location_id, weekday")
  .eq("is_active", true);

const categoryByLocationId = new Map((locationRows ?? []).map((l) => [l.id, l.type as LocationCategory]));
const availableWeekdaysByCategory: Record<string, number[]> = {};
for (const window of availabilityWindows ?? []) {
  const category = categoryByLocationId.get(window.clinic_location_id as string);
  if (!category) continue;
  const weekdays = (availableWeekdaysByCategory[category] ??= []);
  if (!weekdays.includes(window.weekday)) weekdays.push(window.weekday);
}

function todayFortaleza(): string {
  return new Date(Date.now() - 3 * 60 * 60 * 1000).toISOString().slice(0, 10);
}

const dateParam = Astro.url.searchParams.get("date");
const isValidDateParam = dateParam && /^\d{4}-\d{2}-\d{2}$/.test(dateParam) && dateParam >= todayFortaleza();
const date = isValidDateParam ? dateParam : todayFortaleza();

const locationCategoryParam = Astro.url.searchParams.get("location_category");
const locationCategory: LocationCategory =
  locationCategoryParam === "home_visit" ? "home_visit" : (categoryOptions[0]?.value ?? "clinic");

const appointmentType: AppointmentType =
  Astro.url.searchParams.get("appointment_type") === "return_visit" ? "return_visit" : "first_visit";

const errorMessages: Record<string, string> = {
  slot_taken: "Esse horário acabou de deixar de estar livre. Escolha outro.",
  patient_already_scheduled:
    "Esse paciente já tem uma consulta futura marcada. Cancele ou remarque a existente antes de criar uma nova.",
  "1": "Não foi possível marcar a consulta. Confira os dados e tente novamente.",
};
const errorParam = Astro.url.searchParams.get("error");
const errorMessage = errorParam ? (errorMessages[errorParam] ?? errorMessages["1"]) : null;

const clinicLocationIds = await resolveClinicLocationIds(supabase, locationCategory);
const slots = await getAvailableSlotsForDate({ supabase, clinicLocationIds, date, appointmentType });
---

<AdminLayout title="Marcar consulta">
  <a
    href={`/admin/agenda?date=${date}`}
    class="inline-flex items-center gap-1 text-sm font-medium text-sky-700 hover:underline"
  >
    <Icon name="chevron-left" class="h-4 w-4" />
    Agenda
  </a>

  <h1 class="mt-3 text-2xl font-bold text-slate-900">Marcar consulta</h1>

  {
    errorMessage && (
      <p class="mt-4 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">{errorMessage}</p>
    )
  }

  <Card class="mt-6 max-w-xl">
    <form method="POST" action="/api/admin/agenda/appointments" class="flex flex-col gap-6">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
        <div>
          <label for="location_category" class="block text-sm font-medium text-slate-700">Local</label>
          <select
            id="location_category"
            name="location_category"
            class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-sky-600 focus:outline-none focus:ring-1 focus:ring-sky-600"
          >
            {
              categoryOptions.map((option) => (
                <option value={option.value} selected={option.value === locationCategory}>{option.label}</option>
              ))
            }
          </select>
        </div>
        <div>
          <label for="date" class="block text-sm font-medium text-slate-700">Data</label>
          <input
            type="date"
            id="date"
            name="date"
            value={date}
            min={todayFortaleza()}
            class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-sky-600 focus:outline-none focus:ring-1 focus:ring-sky-600"
          />
          <p id="date_availability_warning" class="mt-1 hidden text-xs text-amber-700"></p>
        </div>
        <div>
          <label for="appointment_type" class="block text-sm font-medium text-slate-700">Tipo</label>
          <select
            id="appointment_type"
            name="appointment_type"
            class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-sky-600 focus:outline-none focus:ring-1 focus:ring-sky-600"
          >
            <option value="first_visit" selected={appointmentType === "first_visit"}>Consulta</option>
            <option value="return_visit" selected={appointmentType === "return_visit"}>Retorno</option>
          </select>
        </div>
      </div>

      <div>
        <label for="patient_search" class="block text-sm font-medium text-slate-700">Paciente</label>
        <input
          type="text"
          id="patient_search"
          autocomplete="off"
          placeholder="Buscar pelo nome da criança ou telefone do responsável"
          class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-sky-600 focus:outline-none focus:ring-1 focus:ring-sky-600"
        />
        <input type="hidden" id="patient_id" name="patient_id" required />
        <div id="patient_results" class="mt-1 flex flex-col overflow-hidden rounded-lg border border-slate-200 empty:hidden empty:border-0"></div>
        <p id="patient_warning" class="mt-1 hidden text-xs text-amber-700"></p>
        <p class="mt-1 text-xs text-slate-500">
          Não encontrou?{" "}
          <a href="/admin/pacientes" target="_blank" class="text-sky-700 hover:underline">
            Cadastrar novo paciente
          </a>{" "}
          (abre em outra aba).
        </p>
      </div>

      <div>
        <span class="block text-sm font-medium text-slate-700">Horário</span>
        <div id="slots_container" class="mt-1 flex flex-wrap gap-2">
          {
            slots.length ? (
              slots.map((slot) => (
                <label class="cursor-pointer rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 shadow-sm has-[:checked]:border-sky-700 has-[:checked]:bg-sky-50 has-[:checked]:text-sky-700">
                  <input
                    type="radio"
                    name="start"
                    value={`${slot.start.toISOString()}|${slot.clinicLocationId}`}
                    required
                    class="mr-1"
                  />
                  {slot.label}
                </label>
              ))
            ) : (
              <p class="text-sm text-slate-500">
                Nenhum horário livre para essa data/local. Tente outra data.
              </p>
            )
          }
        </div>
      </div>

      <div class="flex flex-col-reverse gap-2 sm:flex-row sm:items-center">
        <a
          href={`/admin/agenda?date=${date}`}
          class="w-full rounded-md border border-slate-300 px-4 py-3 text-center text-sm font-semibold text-slate-600 hover:bg-slate-50 sm:w-fit"
        >
          Cancelar
        </a>
        <button
          id="submit_btn"
          type="submit"
          class="w-full rounded-md bg-sky-700 px-4 py-3 text-sm font-semibold text-white hover:bg-sky-800 disabled:cursor-not-allowed disabled:opacity-50 sm:w-fit"
        >
          Confirmar agendamento
        </button>
      </div>
    </form>
  </Card>
</AdminLayout>

<script define:vars={{ availableWeekdaysByCategory }} is:inline>
  window.__availableWeekdaysByLocation = availableWeekdaysByCategory;
</script>

<script>
  import { formatPhoneBR } from "../../../lib/phone";

  const searchInput = document.getElementById("patient_search") as HTMLInputElement;
  const hiddenInput = document.getElementById("patient_id") as HTMLInputElement;
  const resultsBox = document.getElementById("patient_results") as HTMLDivElement;
  const warningBox = document.getElementById("patient_warning") as HTMLParagraphElement;
  let debounceTimer: ReturnType<typeof setTimeout>;

  searchInput.addEventListener("input", () => {
    hiddenInput.value = "";
    warningBox.classList.add("hidden");
    clearTimeout(debounceTimer);
    const q = searchInput.value.trim();

    if (q.length < 2) {
      resultsBox.innerHTML = "";
      return;
    }

    debounceTimer = setTimeout(async () => {
      const response = await fetch(`/api/admin/pacientes/search?q=${encodeURIComponent(q)}`);
      const patients = await response.json();
      resultsBox.innerHTML = "";

      patients.forEach(
        (patient: {
          id: string;
          full_name: string;
          guardian_name: string;
          guardian_phone: string;
          has_upcoming_appointment: boolean;
        }) => {
          const item = document.createElement("button");
          item.type = "button";
          item.className =
            "block w-full border-t border-slate-100 px-3 py-2 text-left text-sm first:border-t-0 hover:bg-slate-100";
          const label = `${patient.full_name} — resp. ${patient.guardian_name} (${formatPhoneBR(patient.guardian_phone)})`;
          item.textContent = patient.has_upcoming_appointment ? `${label} ⚠ já tem consulta futura` : label;
          item.addEventListener("click", () => {
            hiddenInput.value = patient.id;
            searchInput.value = label;
            resultsBox.innerHTML = "";
            if (patient.has_upcoming_appointment) {
              warningBox.textContent =
                "Este paciente já tem uma consulta futura marcada — confirmar aqui vai ser bloqueado até essa ser cancelada/remarcada.";
              warningBox.classList.remove("hidden");
            } else {
              warningBox.classList.add("hidden");
            }
          });
          resultsBox.appendChild(item);
        }
      );
    }, 300);
  });

</script>
<script src="../../../scripts/appointmentSlotPicker.ts"></script>
