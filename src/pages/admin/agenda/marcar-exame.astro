---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import Card from "../../../components/admin/Card.astro";
import Icon from "../../../components/admin/Icon.astro";
import { createClient } from "../../../lib/supabase/server";
import { getExamAvailableSlotsForDate } from "../../../lib/scheduling/getExamAvailableSlotsForDate";
import { getExamNextAvailableDates } from "../../../lib/scheduling/getExamNextAvailableDates";
import { getNextAvailableGroupDates, type AvailableGroupSession } from "../../../lib/scheduling/getNextAvailableGroupDates";
import { filterExamTypesWithSchedule } from "../../../lib/scheduling/examScheduleAvailability";
import { formatDateOptionLabel } from "../../../lib/dates";

const supabase = createClient(Astro.request, Astro.cookies);

// Exame só tem um local (`clinic_locations.type='exam'`) — sem pergunta de
// "Consultório ou Domiciliar" (diferente de marcar.astro).
const { data: examLocation } = await supabase
  .from("clinic_locations")
  .select("id")
  .eq("type", "exam")
  .eq("is_active", true)
  .maybeSingle();

const { data: allExamTypes } = await supabase
  .from("exam_types")
  .select("id, name, duration_minutes, scheduling_mode")
  .eq("is_active", true)
  .order("name");

const examTypes = await filterExamTypesWithSchedule(supabase, allExamTypes ?? []);

function todayFortaleza(): string {
  return new Date(Date.now() - 3 * 60 * 60 * 1000).toISOString().slice(0, 10);
}

function groupSessionStartIso(session: AvailableGroupSession): string {
  return new Date(`${session.date}T${session.startTime}:00-03:00`).toISOString();
}

const examTypeIdParam = Astro.url.searchParams.get("exam_type_id");
const examTypeId = examTypes?.some((e) => e.id === examTypeIdParam) ? examTypeIdParam : (examTypes?.[0]?.id ?? "");
const selectedExamType = examTypes?.find((e) => e.id === examTypeId) ?? null;
const isGroupExam = selectedExamType?.scheduling_mode === "group";

// Pré-preenche o paciente quando chega de um link com destinatário já
// identificado (ex.: botão "Remarcar" da aba "Aguardando remarcação",
// Fase 12) — evita ter que buscar de novo alguém que já estava na tela
// anterior.
const prefillPatientId = Astro.url.searchParams.get("patient_id") ?? "";
const prefillPatientLabel = Astro.url.searchParams.get("patient_label") ?? "";

const errorMessages: Record<string, string> = {
  slot_taken: "Esse horário acabou de deixar de estar livre. Escolha outro.",
  patient_already_scheduled:
    "Esse paciente já tem esse tipo de exame marcado no futuro. Cancele ou remarque o existente antes de criar um novo.",
  "1": "Não foi possível marcar o exame. Confira os dados e tente novamente.",
};
const errorParam = Astro.url.searchParams.get("error");
const errorMessage = errorParam ? (errorMessages[errorParam] ?? errorMessages["1"]) : null;

let availableDates: { date: string; weekday: number }[] = [];
let slots: { start: Date; label: string; clinicLocationId: string }[] = [];
let groupDateOptions: AvailableGroupSession[] = [];
let selectedGroupSession: AvailableGroupSession | undefined;
let date = "";

if (selectedExamType && isGroupExam) {
  const sessions = await getNextAvailableGroupDates({ supabase, examTypeId: selectedExamType.id });
  const seenDates = new Set<string>();
  for (const session of sessions) {
    if (seenDates.has(session.date)) continue;
    seenDates.add(session.date);
    groupDateOptions.push(session);
  }

  const dateParam = Astro.url.searchParams.get("date");
  date = dateParam && groupDateOptions.some((d) => d.date === dateParam) ? dateParam : (groupDateOptions[0]?.date ?? "");
  selectedGroupSession = groupDateOptions.find((d) => d.date === date);
} else if (selectedExamType && examLocation) {
  availableDates = await getExamNextAvailableDates({
    supabase,
    examTypeId: selectedExamType.id,
    examLocationId: examLocation.id,
    examDurationMinutes: selectedExamType.duration_minutes,
  });

  const dateParam = Astro.url.searchParams.get("date");
  date = dateParam && availableDates.some((d) => d.date === dateParam) ? dateParam : (availableDates[0]?.date ?? "");

  if (date) {
    slots = await getExamAvailableSlotsForDate({
      supabase,
      examTypeId: selectedExamType.id,
      examLocationId: examLocation.id,
      date,
      examDurationMinutes: selectedExamType.duration_minutes,
    });
  }
}
---

<AdminLayout title="Marcar exame">
  <a
    href={`/admin/agenda?date=${date || todayFortaleza()}`}
    class="inline-flex items-center gap-1 text-sm font-medium text-sky-700 hover:underline"
  >
    <Icon name="chevron-left" class="h-4 w-4" />
    Agenda
  </a>

  <h1 class="mt-3 text-2xl font-bold text-slate-900">Marcar exame</h1>

  {
    !examTypes?.length && (
      <p class="mt-4 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800">
        Nenhum tipo de exame disponível pra marcar — cadastre um em{" "}
        <a href="/admin/configuracoes/exames" class="underline">
          Configurações {"› "}Exames
        </a>{" "}
        e uma disponibilidade em{" "}
        <a href="/admin/configuracoes" class="underline">
          Configurações {"› "}Disponibilidade
        </a>
        .
      </p>
    )
  }

  {
    errorMessage && (
      <p class="mt-4 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">{errorMessage}</p>
    )
  }

  <Card class="mt-6 max-w-xl">
    <form method="POST" action="/api/admin/agenda/appointments" class="flex flex-col gap-6">
      <input type="hidden" name="appointment_type" value="exam" />

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <label for="exam_type_id" class="block text-sm font-medium text-slate-700">Tipo de exame *</label>
          <select
            id="exam_type_id"
            name="exam_type_id"
            required
            class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-sky-600 focus:outline-none focus:ring-1 focus:ring-sky-600"
          >
            {
              examTypes?.map((exam) => (
                <option value={exam.id} selected={exam.id === examTypeId} data-scheduling-mode={exam.scheduling_mode}>
                  {exam.name}{exam.scheduling_mode === "group" ? " (em grupo)" : ""}
                </option>
              ))
            }
          </select>
        </div>
        <div>
          <label for="date" class="block text-sm font-medium text-slate-700">Data *</label>
          {
            isGroupExam ? (
              <select
                id="date"
                name="date"
                required
                disabled={!groupDateOptions.length}
                class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-sky-600 focus:outline-none focus:ring-1 focus:ring-sky-600 disabled:bg-slate-100"
              >
                {groupDateOptions.map((session) => (
                  <option
                    value={session.date}
                    selected={session.date === date}
                    data-start={groupSessionStartIso(session)}
                    data-start-label={session.startTime}
                    data-end-label={session.endTime}
                    data-remaining={session.remainingCapacity}
                  >
                    {formatDateOptionLabel(session.date)}
                  </option>
                ))}
              </select>
            ) : (
              <select
                id="date"
                name="date"
                required
                disabled={!availableDates.length}
                class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-sky-600 focus:outline-none focus:ring-1 focus:ring-sky-600 disabled:bg-slate-100"
              >
                {availableDates.map((d) => (
                  <option value={d.date} selected={d.date === date}>{formatDateOptionLabel(d.date)}</option>
                ))}
              </select>
            )
          }
          <p
            id="date_availability_warning"
            class={`mt-1 text-xs text-amber-700 ${(isGroupExam ? groupDateOptions.length : availableDates.length) ? "hidden" : ""}`}
          >
            {isGroupExam ? "Nenhuma vaga nos próximos dias." : "Nenhum horário livre para esse exame nos próximos dias."} Fale com a
            secretária pelo WhatsApp.
          </p>
        </div>
      </div>

      <div>
        <label for="patient_search" class="block text-sm font-medium text-slate-700">Paciente *</label>
        <input
          type="text"
          id="patient_search"
          autocomplete="off"
          value={prefillPatientLabel}
          placeholder="Buscar pelo nome da criança ou telefone do responsável"
          data-search-category="exame"
          data-already-scheduled-list-suffix="já tem esse tipo de exame marcado"
          data-already-scheduled-message="Este paciente já tem um exame futuro marcado."
          class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-sky-600 focus:outline-none focus:ring-1 focus:ring-sky-600"
        />
        <input type="hidden" id="patient_id" name="patient_id" value={prefillPatientId} />
        <div class="mt-1 flex items-center justify-between gap-2">
          <p id="patient_warning" class="hidden text-xs text-amber-700"></p>
          <button type="button" id="patient_clear" class="hidden shrink-0 text-xs font-medium text-sky-700 hover:underline">
            Trocar paciente
          </button>
        </div>
        <div id="patient_results" class="mt-1 flex flex-col overflow-hidden rounded-lg border border-slate-200 empty:hidden empty:border-0"></div>
        <p class="mt-1 text-xs text-slate-500">
          Não encontrou?{" "}
          <a href="/admin/pacientes" target="_blank" class="text-sky-700 hover:underline">
            Cadastrar novo paciente
          </a>{" "}
          (abre em outra aba).
        </p>
      </div>

      <div>
        <span class="block text-sm font-medium text-slate-700">Horário *</span>
        <div id="slots_container" class="mt-1 flex flex-wrap gap-2" data-exam-location-id={examLocation?.id ?? ""}>
          {
            isGroupExam ? (
              selectedGroupSession ? (
                <>
                  <p class="text-sm text-slate-600">
                    Esse exame é sempre das {selectedGroupSession.startTime} às {selectedGroupSession.endTime} —
                    escolha só a data. Vagas: {selectedGroupSession.remainingCapacity}.
                  </p>
                  <input
                    type="hidden"
                    name="start"
                    value={`${groupSessionStartIso(selectedGroupSession)}|${examLocation?.id ?? ""}`}
                  />
                </>
              ) : (
                <p class="text-sm text-slate-500">Nenhuma vaga nesse dia. Escolha outra data.</p>
              )
            ) : slots.length ? (
              slots.map((slot) => (
                <label class="cursor-pointer rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 shadow-sm has-[:checked]:border-sky-700 has-[:checked]:bg-sky-50 has-[:checked]:text-sky-700">
                  <input
                    type="radio"
                    name="start"
                    value={`${slot.start.toISOString()}|${slot.clinicLocationId}`}
                    required
                    class="mr-1"
                  />
                  {slot.label}
                </label>
              ))
            ) : (
              <p class="text-sm text-slate-500">
                Nenhum horário livre para essa data/exame. Tente outra data.
              </p>
            )
          }
        </div>
      </div>

      <div class="flex flex-col-reverse gap-2 sm:flex-row sm:items-center">
        <a
          href={`/admin/agenda?date=${date || todayFortaleza()}`}
          class="w-full rounded-md border border-slate-300 px-4 py-3 text-center text-sm font-semibold text-slate-600 hover:bg-slate-50 sm:w-fit"
        >
          Cancelar
        </a>
        <button
          id="submit_btn"
          type="submit"
          disabled={!examTypes?.length || (isGroupExam ? !groupDateOptions.length : !availableDates.length)}
          class="w-full rounded-md bg-sky-700 px-4 py-3 text-sm font-semibold text-white hover:bg-sky-800 disabled:cursor-not-allowed disabled:opacity-50 sm:w-fit"
        >
          Confirmar agendamento
        </button>
      </div>
    </form>
  </Card>
</AdminLayout>

<script src="../../../scripts/examSlotPicker.ts"></script>
<script src="../../../scripts/patientSearch.ts"></script>
