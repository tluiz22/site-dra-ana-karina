---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import Card from "../../../components/admin/Card.astro";
import Icon from "../../../components/admin/Icon.astro";
import { createClient } from "../../../lib/supabase/server";
import { getAvailableSlotsForDate } from "../../../lib/scheduling/getAvailableSlotsForDate";

const supabase = createClient(Astro.request, Astro.cookies);

// Exame só tem um local (`clinic_locations.type='exam'`) — sem pergunta de
// "Consultório ou Domiciliar" (diferente de marcar.astro).
const { data: examLocation } = await supabase
  .from("clinic_locations")
  .select("id")
  .eq("type", "exam")
  .eq("is_active", true)
  .maybeSingle();

const { data: examTypes } = await supabase
  .from("exam_types")
  .select("id, name, duration_minutes")
  .eq("is_active", true)
  .order("name");

const { data: availabilityWindows } = examLocation
  ? await supabase
      .from("availability_windows")
      .select("weekday")
      .eq("clinic_location_id", examLocation.id)
      .eq("is_active", true)
  : { data: [] };

const availableWeekdaysForExam = [...new Set((availabilityWindows ?? []).map((w) => w.weekday))];

function todayFortaleza(): string {
  return new Date(Date.now() - 3 * 60 * 60 * 1000).toISOString().slice(0, 10);
}

const dateParam = Astro.url.searchParams.get("date");
const isValidDateParam = dateParam && /^\d{4}-\d{2}-\d{2}$/.test(dateParam) && dateParam >= todayFortaleza();
const date = isValidDateParam ? dateParam : todayFortaleza();

const examTypeIdParam = Astro.url.searchParams.get("exam_type_id");
const examTypeId = examTypes?.some((e) => e.id === examTypeIdParam) ? examTypeIdParam : (examTypes?.[0]?.id ?? "");
const selectedExamType = examTypes?.find((e) => e.id === examTypeId) ?? null;

// Pré-preenche o paciente quando chega de um link com destinatário já
// identificado (ex.: botão "Remarcar" da aba "Aguardando remarcação",
// Fase 12) — evita ter que buscar de novo alguém que já estava na tela
// anterior.
const prefillPatientId = Astro.url.searchParams.get("patient_id") ?? "";
const prefillPatientLabel = Astro.url.searchParams.get("patient_label") ?? "";

const errorMessages: Record<string, string> = {
  slot_taken: "Esse horário acabou de deixar de estar livre. Escolha outro.",
  patient_already_scheduled:
    "Esse paciente já tem esse tipo de exame marcado no futuro. Cancele ou remarque o existente antes de criar um novo.",
  "1": "Não foi possível marcar o exame. Confira os dados e tente novamente.",
};
const errorParam = Astro.url.searchParams.get("error");
const errorMessage = errorParam ? (errorMessages[errorParam] ?? errorMessages["1"]) : null;

const slots =
  examLocation && selectedExamType
    ? await getAvailableSlotsForDate({
        supabase,
        clinicLocationIds: [examLocation.id],
        date,
        appointmentType: "exam",
        examDurationMinutes: selectedExamType.duration_minutes,
      })
    : [];
---

<AdminLayout title="Marcar exame">
  <a
    href={`/admin/agenda?date=${date}`}
    class="inline-flex items-center gap-1 text-sm font-medium text-sky-700 hover:underline"
  >
    <Icon name="chevron-left" class="h-4 w-4" />
    Agenda
  </a>

  <h1 class="mt-3 text-2xl font-bold text-slate-900">Marcar exame</h1>

  {
    !examTypes?.length && (
      <p class="mt-4 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800">
        Nenhum tipo de exame cadastrado ainda —{" "}
        <a href="/admin/configuracoes/exames" class="underline">
          cadastre um em Configurações
        </a>{" "}
        antes de marcar.
      </p>
    )
  }

  {
    errorMessage && (
      <p class="mt-4 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">{errorMessage}</p>
    )
  }

  <Card class="mt-6 max-w-xl">
    <form method="POST" action="/api/admin/agenda/appointments" class="flex flex-col gap-6">
      <input type="hidden" name="appointment_type" value="exam" />

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <label for="exam_type_id" class="block text-sm font-medium text-slate-700">Tipo de exame</label>
          <select
            id="exam_type_id"
            name="exam_type_id"
            class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-sky-600 focus:outline-none focus:ring-1 focus:ring-sky-600"
          >
            {
              examTypes?.map((exam) => (
                <option value={exam.id} selected={exam.id === examTypeId}>{exam.name}</option>
              ))
            }
          </select>
        </div>
        <div>
          <label for="date" class="block text-sm font-medium text-slate-700">Data</label>
          <input
            type="date"
            id="date"
            name="date"
            value={date}
            min={todayFortaleza()}
            class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-sky-600 focus:outline-none focus:ring-1 focus:ring-sky-600"
          />
          <p id="date_availability_warning" class="mt-1 hidden text-xs text-amber-700"></p>
        </div>
      </div>

      <div>
        <label for="patient_search" class="block text-sm font-medium text-slate-700">Paciente</label>
        <input
          type="text"
          id="patient_search"
          autocomplete="off"
          value={prefillPatientLabel}
          placeholder="Buscar pelo nome da criança ou telefone do responsável"
          class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-sky-600 focus:outline-none focus:ring-1 focus:ring-sky-600"
        />
        <input type="hidden" id="patient_id" name="patient_id" value={prefillPatientId} required />
        <div id="patient_results" class="mt-1 flex flex-col overflow-hidden rounded-lg border border-slate-200 empty:hidden empty:border-0"></div>
        <p id="patient_warning" class="mt-1 hidden text-xs text-amber-700"></p>
        <p class="mt-1 text-xs text-slate-500">
          Não encontrou?{" "}
          <a href="/admin/pacientes" target="_blank" class="text-sky-700 hover:underline">
            Cadastrar novo paciente
          </a>{" "}
          (abre em outra aba).
        </p>
      </div>

      <div>
        <span class="block text-sm font-medium text-slate-700">Horário</span>
        <div id="slots_container" class="mt-1 flex flex-wrap gap-2">
          {
            slots.length ? (
              slots.map((slot) => (
                <label class="cursor-pointer rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 shadow-sm has-[:checked]:border-sky-700 has-[:checked]:bg-sky-50 has-[:checked]:text-sky-700">
                  <input
                    type="radio"
                    name="start"
                    value={`${slot.start.toISOString()}|${slot.clinicLocationId}`}
                    required
                    class="mr-1"
                  />
                  {slot.label}
                </label>
              ))
            ) : (
              <p class="text-sm text-slate-500">
                Nenhum horário livre para essa data/exame. Tente outra data.
              </p>
            )
          }
        </div>
      </div>

      <div class="flex flex-col-reverse gap-2 sm:flex-row sm:items-center">
        <a
          href={`/admin/agenda?date=${date}`}
          class="w-full rounded-md border border-slate-300 px-4 py-3 text-center text-sm font-semibold text-slate-600 hover:bg-slate-50 sm:w-fit"
        >
          Cancelar
        </a>
        <button
          id="submit_btn"
          type="submit"
          disabled={!examTypes?.length}
          class="w-full rounded-md bg-sky-700 px-4 py-3 text-sm font-semibold text-white hover:bg-sky-800 disabled:cursor-not-allowed disabled:opacity-50 sm:w-fit"
        >
          Confirmar agendamento
        </button>
      </div>
    </form>
  </Card>
</AdminLayout>

<script define:vars={{ availableWeekdaysForExam }} is:inline>
  window.__availableWeekdaysForExam = availableWeekdaysForExam;
</script>

<script>
  const examTypeSelect = document.getElementById("exam_type_id") as HTMLSelectElement;
  const dateInput = document.getElementById("date") as HTMLInputElement;
  const slotsContainer = document.getElementById("slots_container") as HTMLDivElement;
  const dateWarning = document.getElementById("date_availability_warning") as HTMLParagraphElement;
  const submitBtn = document.getElementById("submit_btn") as HTMLButtonElement;
  const availableWeekdaysForExam = (window as any).__availableWeekdaysForExam as number[];

  function weekdayInFortaleza(dateStr: string): number {
    return new Date(`${dateStr}T00:00:00-03:00`).getUTCDay();
  }

  function isExamAvailableOnDate(): boolean {
    if (!dateInput.value) return true;
    return availableWeekdaysForExam.includes(weekdayInFortaleza(dateInput.value));
  }

  function showDateUnavailableWarning() {
    dateWarning.textContent = "Não há atendimento de exames nesse dia da semana. Escolha outra data.";
    dateWarning.classList.remove("hidden");
    submitBtn.disabled = true;
    slotsContainer.innerHTML = "";
  }

  async function refreshSlots() {
    if (!examTypeSelect.value || !dateInput.value) return;

    if (!isExamAvailableOnDate()) {
      showDateUnavailableWarning();
      return;
    }

    dateWarning.classList.add("hidden");
    submitBtn.disabled = false;

    slotsContainer.innerHTML = '<p class="text-sm text-slate-500">Carregando horários…</p>';

    const params = new URLSearchParams({
      exam_type_id: examTypeSelect.value,
      date: dateInput.value,
    });

    const response = await fetch(`/api/admin/agenda/available-exam-slots?${params.toString()}`);
    const { slots } = await response.json();
    slotsContainer.innerHTML = "";

    if (!slots.length) {
      slotsContainer.innerHTML =
        '<p class="text-sm text-slate-500">Nenhum horário livre para essa data/exame. Tente outra data.</p>';
      return;
    }

    slots.forEach((slot: { start: string; label: string; clinicLocationId: string }) => {
      const label = document.createElement("label");
      label.className =
        "cursor-pointer rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm font-medium text-slate-700 shadow-sm has-[:checked]:border-sky-700 has-[:checked]:bg-sky-50 has-[:checked]:text-sky-700";
      const input = document.createElement("input");
      input.type = "radio";
      input.name = "start";
      input.value = `${slot.start}|${slot.clinicLocationId}`;
      input.required = true;
      input.className = "mr-1";
      label.appendChild(input);
      label.append(slot.label);
      slotsContainer.appendChild(label);
    });
  }

  if (!isExamAvailableOnDate()) showDateUnavailableWarning();

  examTypeSelect.addEventListener("change", refreshSlots);
  dateInput.addEventListener("change", refreshSlots);
</script>

<script>
  import { formatPhoneBR } from "../../../lib/phone";

  const searchInput = document.getElementById("patient_search") as HTMLInputElement;
  const hiddenInput = document.getElementById("patient_id") as HTMLInputElement;
  const resultsBox = document.getElementById("patient_results") as HTMLDivElement;
  const warningBox = document.getElementById("patient_warning") as HTMLParagraphElement;
  let debounceTimer: ReturnType<typeof setTimeout>;

  searchInput.addEventListener("input", () => {
    hiddenInput.value = "";
    warningBox.classList.add("hidden");
    clearTimeout(debounceTimer);
    const q = searchInput.value.trim();

    if (q.length < 2) {
      resultsBox.innerHTML = "";
      return;
    }

    debounceTimer = setTimeout(async () => {
      const response = await fetch(`/api/admin/pacientes/search?q=${encodeURIComponent(q)}&category=exame`);
      const patients = await response.json();
      resultsBox.innerHTML = "";

      patients.forEach(
        (patient: {
          id: string;
          full_name: string;
          guardian_name: string;
          guardian_phone: string;
          has_upcoming_appointment: boolean;
        }) => {
          const item = document.createElement("button");
          item.type = "button";
          item.className =
            "block w-full border-t border-slate-100 px-3 py-2 text-left text-sm first:border-t-0 hover:bg-slate-100";
          const label = `${patient.full_name} — resp. ${patient.guardian_name} (${formatPhoneBR(patient.guardian_phone)})`;
          item.textContent = patient.has_upcoming_appointment ? `${label} ⚠ já tem esse tipo de exame marcado` : label;
          item.addEventListener("click", () => {
            hiddenInput.value = patient.id;
            searchInput.value = label;
            resultsBox.innerHTML = "";
            if (patient.has_upcoming_appointment) {
              warningBox.textContent =
                "Este paciente já tem um exame futuro marcado — se for o mesmo tipo, confirmar aqui vai ser bloqueado até esse ser cancelado/remarcado.";
              warningBox.classList.remove("hidden");
            } else {
              warningBox.classList.add("hidden");
            }
          });
          resultsBox.appendChild(item);
        }
      );
    }, 300);
  });
</script>
