---
// Fase 8 — fila de confirmação, mobile-first. "Pendentes" é uma lista curta
// em cards, pra médica confirmar rápido pelo celular. "Confirmadas" tende a
// crescer sem limite (é o histórico do que já foi decidido), por isso usa
// grid com paginação — mesmo padrão da tela de Pacientes — em vez de cards.
//
// Fase 12 — aba "Resumo do dia" (padrão ao abrir a página): visão mais
// detalhada que a Agenda (idade, responsável, telefone com link pra ligar),
// lida direto do Supabase (sem depender da API do Calendar) — é uma
// referência de identificação do dia, não a ferramenta de gestão pontual da
// grade (isso continua sendo a Agenda). Base pra próxima etapa: seleção pra
// cancelamento em massa.
import AdminLayout from "../../../layouts/AdminLayout.astro";
import Card from "../../../components/admin/Card.astro";
import Badge from "../../../components/admin/Badge.astro";
import type { BadgeVariant } from "../../../components/admin/Badge.astro";
import Icon from "../../../components/admin/Icon.astro";
import { createClient } from "../../../lib/supabase/server";
import { buildAppointmentTypeLabel } from "../../../lib/whatsapp/notifications";
import { formatWhen, TIMEZONE } from "../../../lib/whatsapp/formatDateTime";
import { formatPhoneBR } from "../../../lib/phone";
import { formatAge } from "../../../lib/age";

const PAST_WINDOW_DAYS = 60;
const PAGE_SIZE = 20;

const supabase = createClient(Astro.request, Astro.cookies);

const tabParam = Astro.url.searchParams.get("tab");
const tab: "resumo" | "pendentes" | "confirmadas" | "aguardando_remarcacao" =
  tabParam === "pendentes"
    ? "pendentes"
    : tabParam === "confirmadas"
      ? "confirmadas"
      : tabParam === "aguardando_remarcacao"
        ? "aguardando_remarcacao"
        : "resumo";

const now = new Date();

function todayFortaleza(): string {
  return new Date(Date.now() - 3 * 60 * 60 * 1000).toISOString().slice(0, 10);
}

function addDays(dateStr: string, delta: number): string {
  const d = new Date(`${dateStr}T12:00:00Z`);
  d.setUTCDate(d.getUTCDate() + delta);
  return d.toISOString().slice(0, 10);
}

function formatTime(iso: string): string {
  return new Intl.DateTimeFormat("pt-BR", {
    timeZone: TIMEZONE,
    hour: "2-digit",
    minute: "2-digit",
    hour12: false,
  }).format(new Date(iso));
}

function locationLabel(type: string | undefined): string {
  if (type === "clinic") return "Consultório";
  if (type === "exam") return "Exames";
  return "Domiciliar";
}

function typeBadgeVariant(type: string): BadgeVariant {
  if (type === "exam") return "warning";
  if (type === "return_visit") return "accent";
  return "info";
}

function mapRow(a: {
  id: string;
  scheduled_at: string;
  appointment_type: string;
  status: string;
  patients: unknown;
  exam_types: unknown;
  clinic_locations: unknown;
}) {
  const patient = (a.patients ?? null) as unknown as { full_name: string } | null;
  const examType = (a.exam_types ?? null) as unknown as { name: string } | null;
  const location = (a.clinic_locations ?? null) as unknown as { type: string } | null;

  return {
    id: a.id,
    patientName: patient?.full_name ?? "Paciente",
    typeLabel: buildAppointmentTypeLabel(a.appointment_type, examType?.name),
    typeVariant: typeBadgeVariant(a.appointment_type),
    locationLabel: locationLabel(location?.type),
    whenLabel: formatWhen(new Date(a.scheduled_at)),
    status: a.status,
  };
}

function mapResumoRow(
  a: {
    id: string;
    scheduled_at: string;
    appointment_type: string;
    google_event_id: string | null;
    patients: unknown;
    exam_types: unknown;
    clinic_locations: unknown;
  },
  referenceDate: string
) {
  const patient = (a.patients ?? null) as unknown as {
    full_name: string;
    birthdate: string | null;
    guardians: { full_name: string; phone: string } | null;
  } | null;
  const guardian = patient?.guardians ?? null;
  const examType = (a.exam_types ?? null) as unknown as { name: string } | null;
  const location = (a.clinic_locations ?? null) as unknown as { type: string } | null;

  return {
    id: a.id,
    googleEventId: a.google_event_id,
    time: formatTime(a.scheduled_at),
    patientName: patient?.full_name ?? "Paciente",
    age: patient?.birthdate ? formatAge(patient.birthdate, referenceDate) : null,
    guardianName: guardian?.full_name ?? "—",
    guardianPhone: guardian?.phone ?? null,
    typeLabel: buildAppointmentTypeLabel(a.appointment_type, examType?.name),
    typeVariant: typeBadgeVariant(a.appointment_type),
    locationLabel: locationLabel(location?.type),
  };
}

function tabUrl(target: "resumo" | "pendentes" | "confirmadas" | "aguardando_remarcacao"): string {
  return `/admin/consultas?tab=${target}`;
}

// Leva pra "Marcar consulta"/"Marcar exame" com o paciente já selecionado —
// a consulta cancelada já morreu (Calendar e status), não dá pra usar o
// fluxo de "remarcar" de uma consulta ativa; é uma marcação nova.
function buildRebookUrl(
  appointmentType: string,
  patientId: string,
  patientName: string,
  guardian: { full_name: string; phone: string } | null,
  examTypeId: string | null
): string {
  const label = guardian ? `${patientName} — resp. ${guardian.full_name} (${formatPhoneBR(guardian.phone)})` : patientName;
  const params = new URLSearchParams({ patient_id: patientId, patient_label: label });

  if (appointmentType === "exam") {
    if (examTypeId) params.set("exam_type_id", examTypeId);
    return `/admin/agenda/marcar-exame?${params.toString()}`;
  }

  params.set("appointment_type", appointmentType === "return_visit" ? "return_visit" : "first_visit");
  return `/admin/agenda/marcar?${params.toString()}`;
}

function mapAguardandoRow(a: {
  id: string;
  patient_id: string;
  scheduled_at: string;
  appointment_type: string;
  patients: unknown;
  exam_types: unknown;
}) {
  const patient = (a.patients ?? null) as unknown as {
    full_name: string;
    guardians: { full_name: string; phone: string } | null;
  } | null;
  const guardian = patient?.guardians ?? null;
  const examType = (a.exam_types ?? null) as unknown as { id: string; name: string } | null;
  const patientName = patient?.full_name ?? "Paciente";

  return {
    id: a.id,
    patientName,
    guardianName: guardian?.full_name ?? "—",
    guardianPhone: guardian?.phone ?? null,
    typeLabel: buildAppointmentTypeLabel(a.appointment_type, examType?.name),
    typeVariant: typeBadgeVariant(a.appointment_type),
    whenLabel: formatWhen(new Date(a.scheduled_at)),
    rebookUrl: buildRebookUrl(a.appointment_type, a.patient_id, patientName, guardian, examType?.id ?? null),
  };
}

const SELECT_COLUMNS =
  "id, scheduled_at, appointment_type, status, patients ( full_name ), exam_types ( name ), clinic_locations ( type )";

let cards: ReturnType<typeof mapRow>[] = [];
let rows: ReturnType<typeof mapRow>[] = [];
let page = 1;
let totalPages = 1;
let resumoRows: ReturnType<typeof mapResumoRow>[] = [];
let aguardandoRows: ReturnType<typeof mapAguardandoRow>[] = [];

const dateParam = Astro.url.searchParams.get("date");
const date = dateParam && /^\d{4}-\d{2}-\d{2}$/.test(dateParam) ? dateParam : todayFortaleza();

if (tab === "resumo") {
  const dayStart = `${date}T00:00:00-03:00`;
  const dayEnd = `${addDays(date, 1)}T00:00:00-03:00`;

  const { data } = await supabase
    .from("appointments")
    .select(
      "id, scheduled_at, appointment_type, google_event_id, patients ( full_name, birthdate, guardians ( full_name, phone ) ), exam_types ( name ), clinic_locations ( type )"
    )
    .neq("status", "canceled")
    .gte("scheduled_at", dayStart)
    .lt("scheduled_at", dayEnd)
    .order("scheduled_at", { ascending: true });

  resumoRows = (data ?? []).map((row) => mapResumoRow(row, date));
} else if (tab === "pendentes") {
  const windowStart = new Date(now.getTime() - PAST_WINDOW_DAYS * 24 * 60 * 60 * 1000);
  const { data } = await supabase
    .from("appointments")
    .select(SELECT_COLUMNS)
    .in("status", ["scheduled", "confirmed"])
    .lt("scheduled_at", now.toISOString())
    .gte("scheduled_at", windowStart.toISOString())
    .order("scheduled_at", { ascending: false });

  cards = (data ?? []).map(mapRow);
} else if (tab === "aguardando_remarcacao") {
  // Cancelamentos feitos pela equipe (Fase 12) cujo paciente ainda não tem
  // uma consulta/exame novo marcado — sai da lista sozinho quando remarca,
  // sem precisar de nenhuma ação manual de "resolver".
  const { data: canceledRows } = await supabase
    .from("appointments")
    .select(
      "id, patient_id, scheduled_at, appointment_type, patients ( full_name, guardians ( full_name, phone ) ), exam_types ( id, name )"
    )
    .eq("status", "canceled")
    .eq("canceled_via", "admin")
    .order("scheduled_at", { ascending: false });

  const patientIds = [...new Set((canceledRows ?? []).map((r) => r.patient_id))];

  const { data: rebookedRows } = patientIds.length
    ? await supabase
        .from("appointments")
        .select("patient_id")
        .in("patient_id", patientIds)
        .in("status", ["scheduled", "confirmed"])
        .gt("scheduled_at", now.toISOString())
    : { data: [] as { patient_id: string }[] };

  const rebookedPatientIds = new Set((rebookedRows ?? []).map((r) => r.patient_id));

  // Um paciente pode ter mais de um cancelamento feito pela equipe (ex.:
  // duas datas seguidas desmarcadas) — mostra só o mais recente por
  // paciente, não um card por cancelamento. Consulta/retorno e exame
  // continuam contados separadamente (jornadas separadas, mesmo critério
  // usado no resto do sistema): um paciente com os dois cancelados aparece
  // uma vez pra cada.
  const seenKeys = new Set<string>();
  const dedupedCanceledRows = (canceledRows ?? []).filter((r) => {
    const examTypeId = (r.exam_types as unknown as { id: string } | null)?.id;
    const key = r.appointment_type === "exam" ? `${r.patient_id}:exam:${examTypeId}` : `${r.patient_id}:consulta`;
    if (seenKeys.has(key)) return false;
    seenKeys.add(key);
    return true;
  });

  aguardandoRows = dedupedCanceledRows
    .filter((r) => !rebookedPatientIds.has(r.patient_id))
    .map(mapAguardandoRow);
} else {
  page = Math.max(1, Number(Astro.url.searchParams.get("page")) || 1);
  const from = (page - 1) * PAGE_SIZE;
  const to = from + PAGE_SIZE - 1;

  const { data, count } = await supabase
    .from("appointments")
    .select(SELECT_COLUMNS, { count: "exact" })
    .in("status", ["completed", "no_show"])
    .order("scheduled_at", { ascending: false })
    .range(from, to);

  rows = (data ?? []).map(mapRow);
  totalPages = Math.max(1, Math.ceil((count ?? 0) / PAGE_SIZE));
}

function confirmadasPageUrl(targetPage: number): string {
  return `/admin/consultas?tab=confirmadas&page=${targetPage}`;
}
---

<AdminLayout title="Consultas">
  <h1 class="text-2xl font-bold text-slate-900">Consultas</h1>

  <nav class="mt-3 flex gap-x-6 border-b border-slate-200 text-sm font-medium">
    <a
      href={tabUrl("resumo")}
      class={`-mb-px border-b-2 pb-2 ${
        tab === "resumo" ? "border-sky-700 text-sky-700" : "border-transparent text-slate-600 hover:text-sky-700"
      }`}
    >
      Resumo do dia
    </a>
    <a
      href={tabUrl("aguardando_remarcacao")}
      class={`-mb-px border-b-2 pb-2 ${
        tab === "aguardando_remarcacao"
          ? "border-sky-700 text-sky-700"
          : "border-transparent text-slate-600 hover:text-sky-700"
      }`}
    >
      Aguardando remarcação
    </a>
    <a
      href={tabUrl("pendentes")}
      class={`-mb-px border-b-2 pb-2 ${
        tab === "pendentes" ? "border-sky-700 text-sky-700" : "border-transparent text-slate-600 hover:text-sky-700"
      }`}
    >
      Pendentes
    </a>
    <a
      href={tabUrl("confirmadas")}
      class={`-mb-px border-b-2 pb-2 ${
        tab === "confirmadas" ? "border-sky-700 text-sky-700" : "border-transparent text-slate-600 hover:text-sky-700"
      }`}
    >
      Confirmadas
    </a>
  </nav>

  {
    tab === "pendentes" && (
      <p class="mt-3 text-slate-600">
        Confirme quem compareceu às consultas e exames passados. Toque em "Realizada" ou "Não
        compareceu" — dá pra corrigir depois.
      </p>
    )
  }

  {
    tab === "resumo" && (
      <>
        <form
          method="GET"
          action="/admin/consultas"
          class="mt-6 flex items-center gap-1 rounded-lg border border-slate-200 bg-white p-2 sm:inline-flex"
        >
          <input type="hidden" name="tab" value="resumo" />
          <a
            href={`/admin/consultas?tab=resumo&date=${addDays(date, -1)}`}
            aria-label="Dia anterior"
            class="rounded-md p-2 text-slate-500 hover:bg-slate-100 hover:text-sky-700"
          >
            <Icon name="chevron-left" class="h-5 w-5" />
          </a>
          <input
            type="date"
            name="date"
            value={date}
            onchange="this.form.submit()"
            class="min-w-0 flex-1 rounded-md border border-slate-300 px-3 py-2 text-sm sm:flex-none"
          />
          <a
            href={`/admin/consultas?tab=resumo&date=${addDays(date, 1)}`}
            aria-label="Próximo dia"
            class="rounded-md p-2 text-slate-500 hover:bg-slate-100 hover:text-sky-700"
          >
            <Icon name="chevron-right" class="h-5 w-5" />
          </a>
          {date !== todayFortaleza() && (
            <a
              href="/admin/consultas?tab=resumo"
              class="ml-1 shrink-0 rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50"
            >
              Hoje
            </a>
          )}
        </form>

        {resumoRows.length > 0 && (
          <div class="mt-6 flex flex-wrap items-center justify-between gap-3">
            <div class="flex gap-3 text-sm">
              <button type="button" id="select_all_btn" class="text-sky-700 hover:underline">
                Selecionar todos
              </button>
              <button type="button" id="select_none_btn" class="text-sky-700 hover:underline">
                Selecionar nenhum
              </button>
            </div>
            <button
              type="button"
              id="mass_cancel_open_btn"
              class="rounded-md border border-red-300 px-3 py-2 text-sm font-semibold text-red-700 hover:bg-red-50 disabled:cursor-not-allowed disabled:opacity-50"
            >
              Cancelar selecionados (<span id="mass_cancel_count">0</span>)
            </button>
          </div>
        )}

        <div class="mt-4 flex flex-col gap-3">
          {resumoRows.length ? (
            resumoRows.map((row) => (
              <Card class="flex gap-3">
                <input
                  type="checkbox"
                  class="mass-cancel-checkbox mt-1 h-4 w-4 shrink-0 rounded border-slate-300 text-sky-700 focus:ring-sky-600"
                  value={row.id}
                />
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <span class="text-base font-semibold text-slate-900">{row.time}</span>
                    <Badge variant={row.typeVariant}>{row.typeLabel}</Badge>
                  </div>
                  <p class="mt-2 text-sm font-medium text-slate-900">
                    {row.patientName}
                    {row.age && <span class="font-normal text-slate-500"> · {row.age}</span>}
                  </p>
                  <p class="mt-0.5 text-sm text-slate-500">
                    Resp.: {row.guardianName}
                    {row.guardianPhone && (
                      <>
                        {" · "}
                        <a href={`tel:${row.guardianPhone}`} class="text-sky-700 hover:underline">
                          {formatPhoneBR(row.guardianPhone)}
                        </a>
                      </>
                    )}
                  </p>
                  <p class="mt-0.5 text-xs text-slate-400">{row.locationLabel}</p>
                  {row.googleEventId && (
                    <button
                      type="button"
                      class="cancel-appointment-btn mt-2 rounded-md border border-red-300 px-3 py-1.5 text-xs font-semibold text-red-700 hover:bg-red-50"
                      data-event-id={row.googleEventId}
                      data-appointment-id={row.id}
                    >
                      Cancelar
                    </button>
                  )}
                </div>
              </Card>
            ))
          ) : (
            <Card class="text-slate-500">Nenhum atendimento agendado para esse dia.</Card>
          )}
        </div>

        <dialog
          id="mass_cancel_dialog"
          class="w-[calc(100%-2rem)] max-w-sm rounded-lg border border-slate-200 bg-white p-0 shadow-xl backdrop:bg-slate-900/40"
        >
          <div class="p-5">
            <h2 class="text-base font-semibold text-slate-900">Cancelar atendimentos selecionados?</h2>
            <p class="mt-2 text-sm text-slate-600">
              <span id="mass_cancel_dialog_count">0</span> atendimento(s) serão cancelados no Calendar. Cada
              responsável recebe um aviso por WhatsApp (motivo: imprevisto da médica) com um link novo pra remarcar,
              válido por 2 dias.
            </p>
            <p id="mass_cancel_dialog_error" class="mt-2 hidden text-sm text-red-700">
              Não foi possível cancelar. Tente novamente.
            </p>
            <div class="mt-5 flex justify-end gap-2">
              <button
                type="button"
                id="mass_cancel_dialog_dismiss"
                class="rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50"
              >
                Voltar
              </button>
              <button
                type="button"
                id="mass_cancel_dialog_accept"
                class="rounded-md bg-red-600 px-3 py-2 text-sm font-medium text-white hover:bg-red-700 disabled:cursor-not-allowed disabled:opacity-50"
              >
                Cancelar atendimentos
              </button>
            </div>
          </div>
        </dialog>

        <dialog
          id="single_cancel_dialog"
          class="w-[calc(100%-2rem)] max-w-sm rounded-lg border border-slate-200 bg-white p-0 shadow-xl backdrop:bg-slate-900/40"
        >
          <div class="p-5">
            <h2 class="text-base font-semibold text-slate-900">Cancelar atendimento?</h2>
            <p class="mt-2 text-sm text-slate-600">
              O horário volta a ficar livre na agenda. O responsável recebe um aviso por WhatsApp.
            </p>
            <p id="single_cancel_dialog_error" class="mt-2 hidden text-sm text-red-700">
              Não foi possível cancelar. Tente novamente.
            </p>
            <div class="mt-5 flex justify-end gap-2">
              <button
                type="button"
                id="single_cancel_dialog_dismiss"
                class="rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50"
              >
                Voltar
              </button>
              <button
                type="button"
                id="single_cancel_dialog_accept"
                class="rounded-md bg-red-600 px-3 py-2 text-sm font-medium text-white hover:bg-red-700 disabled:cursor-not-allowed disabled:opacity-50"
              >
                Cancelar atendimento
              </button>
            </div>
          </div>
        </dialog>
      </>
    )
  }

  {
    tab === "pendentes" && (
      <div class="mt-6 flex max-w-md flex-col gap-3">
        {cards.length ? (
          cards.map((card) => (
            <Card>
              <p class="text-base font-semibold text-slate-900">{card.patientName}</p>
              <div class="mt-1.5 flex flex-wrap items-center gap-2">
                <Badge variant={card.typeVariant}>{card.typeLabel}</Badge>
                <span class="text-sm text-slate-500">{card.locationLabel}</span>
              </div>
              <p class="mt-1 text-sm text-slate-500">{card.whenLabel}</p>

              <div class="mt-3 flex gap-2">
                <form method="POST" action={`/api/admin/consultas/${card.id}/status`} class="flex-1">
                  <input type="hidden" name="status" value="completed" />
                  <input type="hidden" name="tab" value={tab} />
                  <button
                    type="submit"
                    class="w-full rounded-md border border-emerald-700 px-3 py-3 text-sm font-semibold text-emerald-700 hover:bg-emerald-50"
                  >
                    Realizada
                  </button>
                </form>
                <form method="POST" action={`/api/admin/consultas/${card.id}/status`} class="flex-1">
                  <input type="hidden" name="status" value="no_show" />
                  <input type="hidden" name="tab" value={tab} />
                  <button
                    type="submit"
                    class="w-full rounded-md border border-red-700 px-3 py-3 text-sm font-semibold text-red-700 hover:bg-red-50"
                  >
                    Não compareceu
                  </button>
                </form>
              </div>
            </Card>
          ))
        ) : (
          <Card class="text-slate-500">Nenhuma consulta ou exame pendente de confirmação.</Card>
        )}
      </div>
    )
  }

  {
    tab === "confirmadas" && (
      <div class="mt-6">
        <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm">
          <table class="w-full min-w-[720px] border-collapse text-left text-sm">
            <thead class="bg-slate-50 text-slate-600">
              <tr>
                <th class="px-3 py-2 font-medium">Paciente</th>
                <th class="px-3 py-2 font-medium">Tipo</th>
                <th class="px-3 py-2 font-medium">Local</th>
                <th class="px-3 py-2 font-medium">Data/hora</th>
                <th class="px-3 py-2 font-medium">Status</th>
                <th class="px-3 py-2" />
              </tr>
            </thead>
            <tbody>
              {rows.length ? (
                rows.map((row) => (
                  <tr class="border-t border-slate-200">
                    <td class="px-3 py-2">{row.patientName}</td>
                    <td class="px-3 py-2">
                      <Badge variant={row.typeVariant}>{row.typeLabel}</Badge>
                    </td>
                    <td class="px-3 py-2 text-slate-500">{row.locationLabel}</td>
                    <td class="px-3 py-2 text-slate-500">{row.whenLabel}</td>
                    <td class="px-3 py-2">
                      <Badge variant={row.status === "completed" ? "success" : "danger"}>
                        {row.status === "completed" ? "Realizada" : "Não compareceu"}
                      </Badge>
                    </td>
                    <td class="whitespace-nowrap px-3 py-2 text-right">
                      <div class="flex flex-nowrap justify-end gap-1.5">
                        <form method="POST" action={`/api/admin/consultas/${row.id}/status`}>
                          <input type="hidden" name="status" value="completed" />
                          <input type="hidden" name="tab" value={tab} />
                          <input type="hidden" name="page" value={page} />
                          <button
                            type="submit"
                            disabled={row.status === "completed"}
                            class="rounded-md border border-emerald-200 px-2.5 py-1.5 text-xs font-medium text-emerald-700 hover:bg-emerald-50 disabled:cursor-default disabled:border-slate-200 disabled:text-slate-300 disabled:hover:bg-transparent"
                          >
                            Marcar realizada
                          </button>
                        </form>
                        <form method="POST" action={`/api/admin/consultas/${row.id}/status`}>
                          <input type="hidden" name="status" value="no_show" />
                          <input type="hidden" name="tab" value={tab} />
                          <input type="hidden" name="page" value={page} />
                          <button
                            type="submit"
                            disabled={row.status === "no_show"}
                            class="rounded-md border border-red-200 px-2.5 py-1.5 text-xs font-medium text-red-700 hover:bg-red-50 disabled:cursor-default disabled:border-slate-200 disabled:text-slate-300 disabled:hover:bg-transparent"
                          >
                            Marcar não compareceu
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                ))
              ) : (
                <tr class="border-t border-slate-200">
                  <td class="px-3 py-4 text-slate-500" colspan="6">
                    Nenhuma consulta ou exame confirmado ainda.
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        </div>

        {totalPages > 1 && (
          <div class="mt-3 flex items-center justify-between text-sm text-slate-600">
            <span>
              Página {page} de {totalPages}
            </span>
            <div class="flex gap-3">
              {page > 1 && (
                <a href={confirmadasPageUrl(page - 1)} class="text-sky-700 hover:underline">
                  Anterior
                </a>
              )}
              {page < totalPages && (
                <a href={confirmadasPageUrl(page + 1)} class="text-sky-700 hover:underline">
                  Próxima
                </a>
              )}
            </div>
          </div>
        )}
      </div>
    )
  }

  {
    tab === "aguardando_remarcacao" && (
      <div class="mt-6 flex flex-col gap-3">
        {aguardandoRows.length ? (
          aguardandoRows.map((row) => (
            <Card>
              <div class="flex flex-wrap items-center justify-between gap-2">
                <p class="text-base font-semibold text-slate-900">{row.patientName}</p>
                <Badge variant={row.typeVariant}>{row.typeLabel}</Badge>
              </div>
              <p class="mt-1 text-sm text-slate-500">Estava marcado(a) para {row.whenLabel}</p>
              <p class="mt-1.5 text-sm text-slate-700">
                Resp.: {row.guardianName}
                {row.guardianPhone && (
                  <>
                    {" · "}
                    <a href={`tel:${row.guardianPhone}`} class="font-medium text-sky-700 hover:underline">
                      {formatPhoneBR(row.guardianPhone)}
                    </a>
                  </>
                )}
              </p>
              <a
                href={row.rebookUrl}
                class="mt-3 inline-flex items-center justify-center rounded-md bg-sky-700 px-4 py-1.5 text-sm font-semibold text-white hover:bg-sky-800"
              >
                Remarcar
              </a>
            </Card>
          ))
        ) : (
          <Card class="text-slate-500">
            Nenhum paciente aguardando remarcação — todo cancelamento feito pela equipe já foi remarcado.
          </Card>
        )}
      </div>
    )
  }
</AdminLayout>

<script>
  const checkboxes = document.querySelectorAll<HTMLInputElement>(".mass-cancel-checkbox");
  const openBtn = document.getElementById("mass_cancel_open_btn") as HTMLButtonElement | null;
  const countLabel = document.getElementById("mass_cancel_count");
  const dialog = document.getElementById("mass_cancel_dialog") as HTMLDialogElement | null;
  const dialogCount = document.getElementById("mass_cancel_dialog_count");
  const dialogError = document.getElementById("mass_cancel_dialog_error");
  const dismissBtn = document.getElementById("mass_cancel_dialog_dismiss") as HTMLButtonElement | null;
  const acceptBtn = document.getElementById("mass_cancel_dialog_accept") as HTMLButtonElement | null;
  const selectAllBtn = document.getElementById("select_all_btn") as HTMLButtonElement | null;
  const selectNoneBtn = document.getElementById("select_none_btn") as HTMLButtonElement | null;

  // Só existe na aba "Resumo do dia" — nas outras abas nada disso está no DOM.
  if (checkboxes.length && openBtn && countLabel && dialog && dialogCount && dismissBtn && acceptBtn) {
    function selectedIds(): string[] {
      return Array.from(checkboxes)
        .filter((cb) => cb.checked)
        .map((cb) => cb.value);
    }

    function refreshCount(): void {
      const n = selectedIds().length;
      countLabel!.textContent = String(n);
      openBtn!.disabled = n === 0;
    }

    checkboxes.forEach((cb) => cb.addEventListener("change", refreshCount));
    selectAllBtn?.addEventListener("click", () => {
      checkboxes.forEach((cb) => (cb.checked = true));
      refreshCount();
    });
    selectNoneBtn?.addEventListener("click", () => {
      checkboxes.forEach((cb) => (cb.checked = false));
      refreshCount();
    });
    refreshCount();

    openBtn.addEventListener("click", () => {
      dialogCount!.textContent = String(selectedIds().length);
      dialogError?.classList.add("hidden");
      acceptBtn!.disabled = false;
      acceptBtn!.textContent = "Cancelar atendimentos";
      dialog!.showModal();
    });

    dismissBtn.addEventListener("click", () => dialog!.close());
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog!.close();
    });

    acceptBtn.addEventListener("click", async () => {
      const ids = selectedIds();
      if (!ids.length) return;

      acceptBtn!.disabled = true;
      acceptBtn!.textContent = "Cancelando…";
      dialogError?.classList.add("hidden");

      const response = await fetch("/api/admin/consultas/cancelar-em-massa", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ appointmentIds: ids }),
      });

      if (response.ok) {
        window.location.reload();
      } else {
        acceptBtn!.disabled = false;
        acceptBtn!.textContent = "Cancelar atendimentos";
        dialogError?.classList.remove("hidden");
      }
    });
  }

  // Cancelar um atendimento específico do Resumo do dia — mesmo endpoint e
  // padrão de modal já usados na Agenda (dia).
  const singleCancelButtons = document.querySelectorAll<HTMLButtonElement>(".cancel-appointment-btn");
  const singleCancelDialog = document.getElementById("single_cancel_dialog") as HTMLDialogElement | null;
  const singleCancelDismiss = document.getElementById("single_cancel_dialog_dismiss") as HTMLButtonElement | null;
  const singleCancelAccept = document.getElementById("single_cancel_dialog_accept") as HTMLButtonElement | null;
  const singleCancelError = document.getElementById("single_cancel_dialog_error") as HTMLParagraphElement | null;

  if (singleCancelButtons.length && singleCancelDialog && singleCancelDismiss && singleCancelAccept && singleCancelError) {
    let pendingEventId: string | null = null;
    let pendingAppointmentId: string | null = null;

    singleCancelButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        pendingEventId = btn.dataset.eventId!;
        pendingAppointmentId = btn.dataset.appointmentId!;
        singleCancelError!.classList.add("hidden");
        singleCancelAccept!.disabled = false;
        singleCancelAccept!.textContent = "Cancelar atendimento";
        singleCancelDialog!.showModal();
      });
    });

    singleCancelDismiss.addEventListener("click", () => singleCancelDialog!.close());
    singleCancelDialog.addEventListener("click", (event) => {
      if (event.target === singleCancelDialog) singleCancelDialog!.close();
    });

    singleCancelAccept.addEventListener("click", async () => {
      if (!pendingEventId || !pendingAppointmentId) return;

      singleCancelAccept!.disabled = true;
      singleCancelAccept!.textContent = "Cancelando…";
      singleCancelError!.classList.add("hidden");

      const response = await fetch(`/api/admin/agenda/events/${encodeURIComponent(pendingEventId)}/cancel`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ appointmentId: pendingAppointmentId }),
      });

      if (response.ok) {
        window.location.reload();
      } else {
        singleCancelAccept!.disabled = false;
        singleCancelAccept!.textContent = "Cancelar atendimento";
        singleCancelError!.classList.remove("hidden");
      }
    });
  }
</script>
