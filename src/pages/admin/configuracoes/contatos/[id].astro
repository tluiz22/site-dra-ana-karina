---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import { createClient } from "../../../../lib/supabase/server";

const supabase = createClient(Astro.request, Astro.cookies);
const { id } = Astro.params;

const { data: recipient } = await supabase
  .from("notification_recipients")
  .select("id, label, phone, receives_consultas, receives_exames")
  .eq("id", id)
  .maybeSingle();

if (!recipient) {
  return Astro.redirect("/admin/configuracoes/contatos?error=1");
}

const errorParam = Astro.url.searchParams.get("error");
const errorMessage = errorParam ? "Não foi possível salvar. Confira os dados e tente novamente." : null;
---

<AdminLayout title={`Editar ${recipient.label}`}>
  <a href="/admin/configuracoes/contatos" class="text-sm text-sky-700 hover:underline">
    &larr; Contatos
  </a>

  <h1 class="mt-3 text-2xl font-bold text-slate-900">Editar destinatário</h1>

  {
    errorMessage && (
      <p class="mt-4 rounded-md bg-red-50 px-3 py-2 text-sm text-red-700">{errorMessage}</p>
    )
  }

  <form
    method="POST"
    action={`/api/admin/configuracoes/notification-recipients/${recipient.id}`}
    class="mt-4 flex max-w-xl flex-col gap-3 rounded-md border border-slate-200 bg-white p-4"
  >
    <div>
      <label for="label" class="block text-sm font-medium text-slate-700">Rótulo</label>
      <input
        type="text"
        id="label"
        name="label"
        value={recipient.label}
        required
        class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm"
      />
    </div>
    <div>
      <label for="phone" class="block text-sm font-medium text-slate-700">Telefone</label>
      <input
        type="text"
        id="phone"
        name="phone"
        value={recipient.phone}
        required
        class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm"
      />
    </div>
    <div class="flex items-center gap-2">
      <input
        type="checkbox"
        id="receives_consultas"
        name="receives_consultas"
        checked={recipient.receives_consultas}
        class="h-4 w-4 rounded border-slate-300"
      />
      <label for="receives_consultas" class="text-sm text-slate-700">Recebe resumo de consultas</label>
    </div>
    <div class="flex items-center gap-2">
      <input
        type="checkbox"
        id="receives_exames"
        name="receives_exames"
        checked={recipient.receives_exames}
        class="h-4 w-4 rounded border-slate-300"
      />
      <label for="receives_exames" class="text-sm text-slate-700">Recebe resumo de exames</label>
    </div>
    <button
      type="submit"
      class="mt-2 w-fit rounded-md bg-sky-700 px-4 py-2 text-sm font-medium text-white hover:bg-sky-800"
    >
      Salvar
    </button>
  </form>
</AdminLayout>
