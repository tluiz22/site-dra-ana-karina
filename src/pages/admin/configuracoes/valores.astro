---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import ConfiguracoesTabs from "../../../components/admin/ConfiguracoesTabs.astro";
import Card from "../../../components/admin/Card.astro";
import { createClient } from "../../../lib/supabase/server";

const supabase = createClient(Astro.request, Astro.cookies);

const { data: clinicLocations } = await supabase
  .from("clinic_locations")
  .select("id, name, type, price_first_visit_cents")
  .eq("is_active", true)
  .neq("type", "exam")
  .order("type");

const errorParam = Astro.url.searchParams.get("error");
const errorMessage = errorParam ? "Não foi possível salvar. Confira os dados e tente novamente." : null;
---

<AdminLayout title="Configurações">
  <h1 class="text-2xl font-bold text-slate-900">Configurações</h1>
  <p class="mt-2 text-slate-600">Parâmetros usados pela agenda e pelo bot de WhatsApp.</p>

  <ConfiguracoesTabs current="valores" />

  {
    errorMessage && (
      <p class="mt-6 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">{errorMessage}</p>
    )
  }

  <section class="mt-6">
    <h2 class="text-lg font-semibold text-slate-900">Valores</h2>
    <p class="mt-1 text-sm text-slate-600">
      Valor da consulta por local de atendimento — usado nas Informações Gerais do bot e na
      mensagem de confirmação enviada por WhatsApp. O retorno não tem valor próprio: está incluso
      no valor da consulta.
    </p>

    <div class="mt-4 flex flex-col gap-4">
      {
        clinicLocations?.map((location) => (
          <Card>
            <form
              method="POST"
              action={`/api/admin/configuracoes/clinic-locations/${location.id}/price`}
              class="flex flex-wrap items-end gap-3"
            >
              <div class="min-w-[10rem] text-sm font-medium text-slate-700">{location.name}</div>
              <div>
                <label for={`price_first_visit_${location.id}`} class="block text-sm font-medium text-slate-700">
                  Consulta (R$)
                </label>
                <input
                  type="number"
                  min="0"
                  step="0.01"
                  id={`price_first_visit_${location.id}`}
                  name="price_first_visit"
                  value={(location.price_first_visit_cents / 100).toFixed(2)}
                  required
                  class="mt-1 w-28 rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-sky-600 focus:outline-none focus:ring-1 focus:ring-sky-600"
                />
              </div>
              <button
                type="submit"
                class="rounded-md bg-sky-700 px-4 py-2.5 text-sm font-semibold text-white hover:bg-sky-800"
              >
                Salvar
              </button>
            </form>
          </Card>
        ))
      }
    </div>
  </section>
</AdminLayout>
