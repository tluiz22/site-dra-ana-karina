---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import ConfiguracoesTabs from "../../../components/admin/ConfiguracoesTabs.astro";
import { createClient } from "../../../lib/supabase/server";

const supabase = createClient(Astro.request, Astro.cookies);

const { data: clinicLocations } = await supabase
  .from("clinic_locations")
  .select("id, name")
  .eq("is_active", true)
  .order("type");

const { data: availabilityWindows } = await supabase
  .from("availability_windows")
  .select("id, weekday, start_time, end_time, clinic_locations ( name )")
  .order("weekday")
  .order("start_time");

const weekdayLabels = [
  "Domingo",
  "Segunda-feira",
  "Terça-feira",
  "Quarta-feira",
  "Quinta-feira",
  "Sexta-feira",
  "Sábado",
];

const errorMessages: Record<string, string> = {
  overlap: "Esse horário se sobrepõe a um intervalo já cadastrado para esse dia.",
  invalid_range: "O horário de início precisa ser antes do horário de fim.",
  "1": "Não foi possível salvar. Confira os dados e tente novamente.",
};
const errorParam = Astro.url.searchParams.get("error");
const errorMessage = errorParam ? errorMessages[errorParam] ?? errorMessages["1"] : null;
---

<AdminLayout title="Configurações">
  <h1 class="text-2xl font-bold text-slate-900">Configurações</h1>
  <p class="mt-2 text-slate-600">Parâmetros usados pela agenda e pelo bot de WhatsApp.</p>

  <ConfiguracoesTabs current="disponibilidade" />

  {
    errorMessage && (
      <p class="mt-6 rounded-md bg-red-50 px-3 py-2 text-sm text-red-700">{errorMessage}</p>
    )
  }

  <section class="mt-6">
    <h2 class="text-lg font-semibold text-slate-900">Disponibilidade</h2>
    <p class="mt-1 text-sm text-slate-600">
      Dias e horários em que a agenda pode oferecer consulta, por local de atendimento.
    </p>

    <table class="mt-4 w-full border-collapse overflow-hidden rounded-md border border-slate-200 text-left text-sm">
      <thead class="bg-slate-100 text-slate-600">
        <tr>
          <th class="px-3 py-2 font-medium">Local</th>
          <th class="px-3 py-2 font-medium">Dia</th>
          <th class="px-3 py-2 font-medium">Início</th>
          <th class="px-3 py-2 font-medium">Fim</th>
          <th class="px-3 py-2"></th>
        </tr>
      </thead>
      <tbody>
        {
          availabilityWindows?.length ? (
            availabilityWindows.map((window) => (
              <tr class="border-t border-slate-200">
                <td class="px-3 py-2">{(window.clinic_locations as any)?.name}</td>
                <td class="px-3 py-2">{weekdayLabels[window.weekday]}</td>
                <td class="px-3 py-2">{window.start_time.slice(0, 5)}</td>
                <td class="px-3 py-2">{window.end_time.slice(0, 5)}</td>
                <td class="px-3 py-2 text-right">
                  <form method="POST" action={`/api/admin/configuracoes/availability-windows/${window.id}`}>
                    <button
                      type="submit"
                      class="text-xs font-medium text-red-700 hover:underline"
                    >
                      Remover
                    </button>
                  </form>
                </td>
              </tr>
            ))
          ) : (
            <tr class="border-t border-slate-200">
              <td class="px-3 py-4 text-slate-500" colspan="5">
                Nenhum intervalo de disponibilidade cadastrado ainda.
              </td>
            </tr>
          )
        }
      </tbody>
    </table>

    <form
      method="POST"
      action="/api/admin/configuracoes/availability-windows"
      class="mt-4 flex flex-wrap items-end gap-3 rounded-md border border-slate-200 bg-white p-4"
    >
      <div>
        <label for="clinic_location_id" class="block text-sm font-medium text-slate-700">
          Local
        </label>
        <select
          id="clinic_location_id"
          name="clinic_location_id"
          required
          class="mt-1 rounded-md border border-slate-300 px-3 py-2 text-sm"
        >
          {
            clinicLocations?.map((location) => (
              <option value={location.id}>{location.name}</option>
            ))
          }
        </select>
      </div>
      <div>
        <label for="weekday" class="block text-sm font-medium text-slate-700">Dia da semana</label>
        <select
          id="weekday"
          name="weekday"
          required
          class="mt-1 rounded-md border border-slate-300 px-3 py-2 text-sm"
        >
          {weekdayLabels.map((label, index) => <option value={index}>{label}</option>)}
        </select>
      </div>
      <div>
        <label for="start_time" class="block text-sm font-medium text-slate-700">Início</label>
        <input
          type="time"
          id="start_time"
          name="start_time"
          required
          class="mt-1 rounded-md border border-slate-300 px-3 py-2 text-sm"
        />
      </div>
      <div>
        <label for="end_time" class="block text-sm font-medium text-slate-700">Fim</label>
        <input
          type="time"
          id="end_time"
          name="end_time"
          required
          class="mt-1 rounded-md border border-slate-300 px-3 py-2 text-sm"
        />
      </div>
      <button
        type="submit"
        class="rounded-md bg-sky-700 px-4 py-2 text-sm font-medium text-white hover:bg-sky-800"
      >
        Adicionar
      </button>
    </form>
  </section>
</AdminLayout>
