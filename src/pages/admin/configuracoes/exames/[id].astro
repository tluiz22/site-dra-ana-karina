---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import { createClient } from "../../../../lib/supabase/server";

const supabase = createClient(Astro.request, Astro.cookies);
const { id } = Astro.params;

const { data: exam } = await supabase
  .from("exam_types")
  .select("id, name, duration_minutes, price_cents, preparation_instructions")
  .eq("id", id)
  .maybeSingle();

if (!exam) {
  return Astro.redirect("/admin/configuracoes/exames?error=1");
}

const errorParam = Astro.url.searchParams.get("error");
const errorMessage = errorParam ? "Não foi possível salvar. Confira os dados e tente novamente." : null;
---

<AdminLayout title={`Editar ${exam.name}`}>
  <a href="/admin/configuracoes/exames" class="text-sm text-sky-700 hover:underline">
    &larr; Tipos de exame
  </a>

  <h1 class="mt-3 text-2xl font-bold text-slate-900">Editar tipo de exame</h1>

  {
    errorMessage && (
      <p class="mt-4 rounded-md bg-red-50 px-3 py-2 text-sm text-red-700">{errorMessage}</p>
    )
  }

  <form
    method="POST"
    action={`/api/admin/configuracoes/exam-types/${exam.id}`}
    class="mt-4 flex max-w-xl flex-col gap-3 rounded-md border border-slate-200 bg-white p-4"
  >
    <div>
      <label for="name" class="block text-sm font-medium text-slate-700">Nome</label>
      <input
        type="text"
        id="name"
        name="name"
        value={exam.name}
        required
        class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm"
      />
    </div>
    <div>
      <label for="duration_minutes" class="block text-sm font-medium text-slate-700">
        Duração (min)
      </label>
      <input
        type="number"
        min="1"
        id="duration_minutes"
        name="duration_minutes"
        value={exam.duration_minutes}
        required
        class="mt-1 w-28 rounded-md border border-slate-300 px-3 py-2 text-sm"
      />
    </div>
    <div>
      <label for="price" class="block text-sm font-medium text-slate-700">Valor (R$)</label>
      <input
        type="number"
        min="0"
        step="0.01"
        id="price"
        name="price"
        value={(exam.price_cents / 100).toFixed(2)}
        required
        class="mt-1 w-28 rounded-md border border-slate-300 px-3 py-2 text-sm"
      />
    </div>
    <div>
      <label for="preparation_instructions" class="block text-sm font-medium text-slate-700">
        Instruções de preparo
      </label>
      <input
        type="text"
        id="preparation_instructions"
        name="preparation_instructions"
        value={exam.preparation_instructions ?? ""}
        placeholder="ex.: jejum de 8 horas"
        class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm"
      />
    </div>
    <button
      type="submit"
      class="mt-2 w-fit rounded-md bg-sky-700 px-4 py-2 text-sm font-medium text-white hover:bg-sky-800"
    >
      Salvar
    </button>
  </form>
</AdminLayout>
