---
import "../../styles/global.css";

const hasError = Astro.url.searchParams.has("error");
---

<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Entrar | Painel do consultório</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="flex min-h-screen items-center justify-center bg-slate-50 text-slate-900">
    <div class="w-full max-w-sm rounded-lg border border-slate-200 bg-white p-8 shadow-sm">
      <h1 class="text-xl font-bold text-slate-900">Painel do consultório</h1>
      <p class="mt-1 text-sm text-slate-600">Acesso restrito à equipe.</p>
      {
        hasError && (
          <p class="mt-4 rounded-md bg-red-50 px-3 py-2 text-sm text-red-700">
            E-mail ou senha inválidos.
          </p>
        )
      }
      <form method="POST" action="/api/admin/auth/login" class="mt-6 flex flex-col gap-4">
        <div>
          <label for="email" class="block text-sm font-medium text-slate-700">E-mail</label>
          <input
            type="email"
            name="email"
            id="email"
            required
            class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm"
          />
        </div>
        <div>
          <label for="password" class="block text-sm font-medium text-slate-700">Senha</label>
          <input
            type="password"
            name="password"
            id="password"
            required
            class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm"
          />
        </div>
        <button
          type="submit"
          class="mt-2 rounded-md bg-sky-700 px-4 py-2 text-sm font-medium text-white hover:bg-sky-800"
        >
          Entrar
        </button>
      </form>
    </div>
  </body>
</html>
