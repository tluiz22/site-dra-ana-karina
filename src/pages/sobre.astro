---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import EducationTimeline from "../components/EducationTimeline.astro";
import CommitmentChips from "../components/CommitmentChips.astro";
import FinalCta from "../components/FinalCta.astro";
import { doctor } from "../data/doctor";
---

<BaseLayout
  title={`Sobre a ${doctor.professionalName} | Pneumologista pediátrica em Mossoró`}
  description={`Conheça a formação, trajetória e abordagem de atendimento da ${doctor.professionalName}, pneumologista pediátrica em Mossoró/RN.`}
  canonical={Astro.url.href}
>
  <PageHeader eyebrow="Sobre a médica" title={doctor.professionalName} portrait>
    <p class="mt-2 text-ink-secondary">{doctor.name}</p>
    <p class="mt-1 text-caption text-ink-muted">
      {doctor.crm} · {doctor.rqePediatria} · {doctor.rqePneumologia}
    </p>
  </PageHeader>

  <div class="container-text pb-(--space-section)">
    <div class="grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:gap-14">
      <div class="min-w-0 space-y-5 text-lead text-ink-secondary">
        <p>{doctor.shortBio}</p>
        <p>
          Atuação de {doctor.yearsOfExperience} dedicada ao cuidado de
          {" "}{doctor.targetAudience.toLowerCase()}.
        </p>

        <h2 class="pt-6 font-display text-h3-display font-medium text-ink">
          Abordagem de atendimento
        </h2>
        <CommitmentChips />
      </div>

      <EducationTimeline headingLevel="h2" class="min-w-0 self-start" />
    </div>
  </div>

  <FinalCta origin="click_whatsapp_sobre" compact />
</BaseLayout>
