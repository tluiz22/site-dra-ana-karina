---
import BaseLayout from "../layouts/BaseLayout.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import Button from "../components/Button.astro";
---

<BaseLayout
  title="Página não encontrada | Dra. Ana Karina Fernandes"
  description="A página que você tentou acessar não foi encontrada."
  noindex={true}
>
  <div class="container-text flex flex-col items-center py-(--space-section) text-center">
    <p class="eyebrow">Erro 404</p>
    <h1 class="mt-3 font-display text-h1 font-normal text-ink">Página não encontrada</h1>
    <p class="mt-4 max-w-[52ch] text-lead text-ink-secondary">
      A página que você tentou acessar não existe ou foi movida. Você pode voltar para a página
      inicial ou falar diretamente pelo WhatsApp.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <Button href="/">Voltar para a página inicial</Button>
      <WhatsAppButton label="Falar pelo WhatsApp" origin="click_whatsapp_404" />
    </div>
  </div>
</BaseLayout>
