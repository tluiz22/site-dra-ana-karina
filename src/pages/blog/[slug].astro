---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Notice from '../../components/Notice.astro';
import FinalCta from '../../components/FinalCta.astro';
import { doctor } from '../../data/doctor';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={`${post.data.title} | ${doctor.professionalName}`}
  description={post.data.description}
  type="article"
  canonical={Astro.url.href}
>
  <article>
    <PageHeader eyebrow={post.data.category} title={post.data.title} width="prose" byline>
      <time
        datetime={post.data.pubDate.toISOString()}
        class="mt-3 block text-caption text-ink-muted"
      >
        {post.data.pubDate.toLocaleDateString('pt-BR', {
          day: '2-digit',
          month: 'long',
          year: 'numeric',
        })}
      </time>
    </PageHeader>

    <div class="container-prose">
      <div class="prose">
        <Content />
      </div>

      <Notice variant="educational" class="mt-12" />

      <nav aria-label="Navegação do blog" class="mt-10 border-t border-line pt-6">
        <a href="/blog" class="link-action inline-flex min-h-11 items-center">
          <span aria-hidden="true">←&nbsp;</span>Voltar ao blog
        </a>
      </nav>
    </div>
  </article>

  <div class="mt-10">
    <FinalCta
      origin="click_whatsapp_blog"
      title="Ficou com dúvidas sobre a saúde respiratória do seu filho?"
      text="Agende uma avaliação e converse com calma sobre o caso."
      compact
    />
  </div>
</BaseLayout>
