---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ContentListItem from '../../components/ContentListItem.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Blog | Pneumologista pediátrica em Mossoró"
  description="Artigos educativos sobre saúde respiratória infantil escritos pela Dra. Ana Karina, pneumologista pediátrica em Mossoró/RN."
  canonical={Astro.url.href}
>
  <PageHeader
    eyebrow="Blog"
    title="Artigos sobre saúde respiratória infantil"
    subtitle="Conteúdo educativo para entender sintomas, exames e tratamentos."
  />

  <section class="container-text pb-(--space-section)">
    {posts.length === 0 ? (
      <p class="text-ink-secondary">Nenhum artigo publicado ainda.</p>
    ) : (
      <ul class="border-b border-line">
        {posts.map((post) => (
          <ContentListItem
            href={`/blog/${post.id}`}
            category={post.data.category}
            title={post.data.title}
            description={post.data.description}
            date={post.data.pubDate}
          />
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
