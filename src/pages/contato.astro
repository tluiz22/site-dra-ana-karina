---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import Notice from "../components/Notice.astro";
import { doctor, instagramHref } from "../data/doctor";
---

<BaseLayout
  title="Contato e agendamento | Pneumologista pediátrica em Mossoró"
  description={`Entre em contato para agendar consulta com ${doctor.professionalName}, pneumologista pediátrica em ${doctor.location}.`}
  canonical={Astro.url.href}
>
  <PageHeader
    eyebrow="Contato"
    title="Contato e agendamento"
    subtitle="O agendamento de consultas é realizado pelo WhatsApp."
  >
    <div class="mt-7">
      <WhatsAppButton label="Agendar consulta pelo WhatsApp" origin="click_whatsapp_contato" />
    </div>
  </PageHeader>

  <section class="border-t border-line pt-(--space-section-head) pb-(--space-section)">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-[1fr_1.2fr]">
        <section aria-labelledby="atendimento">
          <h2 id="atendimento" class="font-display text-h3-display font-medium text-ink">
            Atendimento
          </h2>
          <dl class="mt-4 grid gap-5">
            <div>
              <dt class="text-caption text-ink-muted">Local</dt>
              <dd class="mt-0.5 font-medium text-ink">{doctor.location}</dd>
            </div>
            <div>
              <dt class="text-caption text-ink-muted">Modalidade</dt>
              <dd class="mt-0.5 font-medium text-ink">
                {doctor.paymentModel}. {doctor.homeVisits}.
              </dd>
            </div>
            <div>
              <dt class="text-caption text-ink-muted">Agendamento</dt>
              <dd class="mt-0.5 font-medium text-ink">Somente pelo WhatsApp {doctor.displayPhone}</dd>
            </div>
          </dl>
        </section>

        <section aria-labelledby="outros-canais">
          <h2 id="outros-canais" class="font-display text-h3-display font-medium text-ink">
            Outros canais
          </h2>
          <ul class="mt-4 space-y-1 text-ink-secondary">
            <li>
              <a href={`mailto:${doctor.email}`} class="link inline-flex min-h-11 items-center break-all">
                {doctor.email}
              </a>
            </li>
            <li>
              <a
                href={instagramHref}
                target="_blank"
                rel="noopener noreferrer"
                class="link inline-flex min-h-11 items-center"
              >
                Instagram @{doctor.instagram}<span class="sr-only"> (abre em nova aba)</span>
              </a>
            </li>
          </ul>
        </section>
      </div>

      <Notice variant="emergency" class="mt-14" />
    </div>
  </section>
</BaseLayout>
