---
import BaseLayout from "../layouts/BaseLayout.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { doctor } from "../data/doctor";

const mapsHref =
  "https://maps.google.com/?q=" +
  encodeURIComponent(
    doctor.address + ", " + doctor.city + ", " + doctor.state
  );
---

<BaseLayout
  title="Contato e agendamento | Pneumologista pediátrica em Mossoró"
  description={`Entre em contato para agendar consulta com ${doctor.professionalName}, pneumologista pediátrica em Mossoró, no ${doctor.clinic}, em ${doctor.city}/${doctor.state}.`}
  canonical={Astro.url.href}
>
  <div class="mx-auto max-w-4xl px-4 py-16">
    <h1 class="text-3xl font-bold text-slate-900">Contato e agendamento</h1>
    <p class="mt-2 text-slate-600">
      O agendamento de consultas é realizado pelo WhatsApp ou pelo formulário abaixo.
    </p>

    <div class="mt-6">
      <WhatsAppButton label="Agendar consulta pelo WhatsApp" origin="click_whatsapp_contato" />
    </div>

    <div class="mt-12 grid gap-8 sm:grid-cols-2">
      <section>
        <h2 class="text-xl font-bold text-slate-900">Local e horário</h2>
        <ul class="mt-3 space-y-2 text-slate-700">
          <li><span class="font-medium">{doctor.clinic}</span></li>
          <li>{doctor.address}<br />{doctor.city}/{doctor.state}</li>
          <li>Horário: {doctor.serviceHours}</li>
        </ul>
        <a
          href={mapsHref}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex items-center text-sm font-medium text-sky-700 hover:text-sky-900"
        >
          Ver rota no Google Maps →
        </a>
      </section>

      <section>
        <h2 class="text-xl font-bold text-slate-900">Outros canais</h2>
        <ul class="mt-3 space-y-2 text-sm text-slate-700">
          <li>
            WhatsApp:
            <a href={`tel:+${doctor.phone}`} class="hover:text-slate-900">{doctor.displayPhone}</a>
          </li>
          <li>
            E-mail:
            <a href={`mailto:${doctor.email}`} class="hover:text-slate-900">{doctor.email}</a>
          </li>
          <li>
            Instagram:
            <a
              href={`https://instagram.com/${doctor.instagram}`}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-slate-900"
            >
              @{doctor.instagram}
            </a>
          </li>
        </ul>
      </section>
    </div>

    <section class="mt-12">
      <h2 class="text-xl font-bold text-slate-900">Formulário de contato</h2>
      <p class="mt-1 text-sm text-slate-500">
        Preencha os dados abaixo. Para retorno mais rápido, utilize o WhatsApp.
      </p>
      {/* TODO: configurar action do formulário em demanda futura (backend/serviço de e-mail) */}
      <form class="mt-4 space-y-5" method="post">
        <div>
          <label for="nome" class="block text-sm font-medium text-slate-700">
            Nome do responsável <span aria-hidden="true">*</span>
          </label>
          <input
            type="text"
            id="nome"
            name="nome"
            required
            autocomplete="name"
            class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500"
          />
        </div>

        <div>
          <label for="telefone" class="block text-sm font-medium text-slate-700">
            Telefone <span aria-hidden="true">*</span>
          </label>
          <input
            type="tel"
            id="telefone"
            name="telefone"
            required
            autocomplete="tel"
            class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500"
          />
        </div>

        <div>
          <label for="mensagem" class="block text-sm font-medium text-slate-700">
            Mensagem <span aria-hidden="true">*</span>
          </label>
          <textarea
            id="mensagem"
            name="mensagem"
            required
            rows="4"
            class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500"
          ></textarea>
        </div>

        <div class="flex items-start gap-2">
          <input
            type="checkbox"
            id="aceite"
            name="aceite"
            required
            class="mt-1 h-4 w-4 rounded border-slate-300 text-sky-600 focus:ring-sky-500"
          />
          <label for="aceite" class="text-sm text-slate-700">
            Declaro que li e aceito a {" "}
            <a href="/politica-de-privacidade" class="text-sky-700 underline hover:text-sky-900">
              Política de Privacidade
            </a>
            {" "}e estou ciente de que este formulário não substitui consulta médica.
            <span aria-hidden="true"> *</span>
          </label>
        </div>

        <button
          type="submit"
          class="inline-flex items-center justify-center rounded-lg bg-slate-900 px-6 py-3 text-sm font-semibold text-white hover:bg-slate-700"
        >
          Enviar mensagem
        </button>
      </form>
    </section>

    <aside
      role="note"
      class="mt-12 rounded-lg border border-amber-200 bg-amber-50 px-4 py-4 text-sm text-amber-900"
    >
      <strong>Aviso de emergência:</strong> Este site não realiza atendimento de urgência ou emergência. Em caso de sintomas intensos, falta de ar, piora rápida ou emergência médica, procure atendimento imediato.
    </aside>
  </div>
</BaseLayout>
