---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/home/Hero.astro";
import WhenToSeek from "../components/home/WhenToSeek.astro";
import AboutSection from "../components/home/AboutSection.astro";
import GuidesSection from "../components/home/GuidesSection.astro";
import FaqSection from "../components/home/FaqSection.astro";
import FinalCta from "../components/FinalCta.astro";
import { faq } from "../data/faq";

const faqStructuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
---

<BaseLayout
  title="Dra. Ana Karina Fernandes | Pneumologista pediátrica em Mossoró"
  description="Atendimento com Dra. Ana Karina Fernandes, pediatra e pneumologista pediátrica em Mossoró/RN. Cuidado especializado para asma infantil, tosse persistente, alergias respiratórias, bronquiolite e saúde respiratória infantil."
  canonical={Astro.url.href}
>
  <Hero />
  <WhenToSeek />
  <AboutSection />
  <GuidesSection />
  <FaqSection />

  <FinalCta origin="click_whatsapp_footer" />

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />
</BaseLayout>
