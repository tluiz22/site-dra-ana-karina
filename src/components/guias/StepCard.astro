---
interface Props {
  number: number;
  title: string;
}

const { number, title } = Astro.props;
---

<div class="flex gap-4 rounded-card bg-surface p-5">
  <span
    class="flex size-9 flex-none items-center justify-center rounded-full bg-brand font-display text-body text-on-inverse"
    aria-hidden="true"
  >
    {number}
  </span>
  <div>
    <h3 class="text-h3 font-semibold text-ink">
      <span class="sr-only">Passo {number}: </span>{title}
    </h3>
    <div class="mt-1 text-small text-ink-secondary">
      <slot />
    </div>
  </div>
</div>
