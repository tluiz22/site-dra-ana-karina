---
interface Props {
  number: number;
  title: string;
}

const { number, title } = Astro.props;
---

<div class="flex gap-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
  <span
    class="flex h-8 w-8 flex-none items-center justify-center rounded-full bg-sky-700 text-sm font-semibold text-white"
    aria-hidden="true"
  >
    {number}
  </span>
  <div>
    <h3 class="font-semibold text-slate-900">{title}</h3>
    <div class="mt-1 text-sm text-slate-600">
      <slot />
    </div>
  </div>
</div>
