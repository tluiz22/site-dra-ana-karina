---
interface Props {
  zone: "verde" | "amarela" | "vermelha";
  title: string;
}

const { zone, title } = Astro.props;

// O nome da zona vem escrito no título ("Zona verde — …"): a cor nunca é a única pista.
const styles = {
  verde: "bg-success-bg text-success-ink",
  amarela: "bg-warning-bg text-warning-ink",
  vermelha: "bg-danger-bg text-danger-ink",
};
---

<div class={`rounded-notice px-5 py-4 ${styles[zone]}`}>
  <p class="flex items-center gap-2 font-semibold">
    <span class="size-2.5 flex-none rounded-full bg-current" aria-hidden="true"></span>
    {title}
  </p>
  <div class="mt-1 text-small">
    <slot />
  </div>
</div>
