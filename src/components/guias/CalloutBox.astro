---
interface Props {
  variant?: "info" | "atencao" | "emergencia";
  title?: string;
}

const { variant = "info", title } = Astro.props;

const styles = {
  info: "bg-subtle text-ink",
  atencao: "bg-warning-bg text-warning-ink",
  emergencia: "bg-danger-bg text-danger-ink",
};
---

<div class={`callout my-6 rounded-notice px-5 py-4 text-small ${styles[variant]}`} role="note">
  {title && <strong class="block font-semibold">{title}</strong>}
  <div class="mt-1">
    <slot />
  </div>
</div>
