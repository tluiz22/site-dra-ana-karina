---
// Selo/pílula reutilizado pelas telas do admin pra tipo/status (ex.: tipo de
// atendimento, "Cancelado"). Ver plano, "Redesenho visual do admin".
export type BadgeVariant = "neutral" | "info" | "accent" | "success" | "warning" | "danger";

interface Props {
  variant?: BadgeVariant;
  class?: string;
}

const { variant = "neutral", class: className = "" } = Astro.props;

const variants: Record<BadgeVariant, string> = {
  neutral: "bg-slate-100 text-slate-600",
  info: "bg-sky-100 text-sky-700",
  accent: "bg-indigo-100 text-indigo-700",
  success: "bg-emerald-100 text-emerald-700",
  warning: "bg-amber-100 text-amber-700",
  danger: "bg-red-100 text-red-700",
};
---

<span class={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium ${variants[variant]} ${className}`}>
  <slot />
</span>
