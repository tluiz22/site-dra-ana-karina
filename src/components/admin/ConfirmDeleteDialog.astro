---
// Modal de confirmação reutilizado por qualquer botão "Excluir" do admin —
// não usa window.confirm() (mostra a URL da página no título, o que não
// fica bom). Qualquer botão com a classe "js-confirm-delete" dentro de um
// <form> passa a abrir este modal antes de enviar; a mensagem vem do
// atributo data-confirm-message do próprio botão. Ver src/scripts/confirmDelete.ts.
---

<dialog
  id="delete_dialog"
  class="w-[calc(100%-2rem)] max-w-sm rounded-lg border border-slate-200 bg-white p-0 shadow-xl backdrop:bg-slate-900/40"
>
  <div class="p-5">
    <h2 class="text-base font-semibold text-slate-900">Excluir?</h2>
    <p id="delete_dialog_message" class="mt-2 text-sm text-slate-600"></p>
    <div class="mt-5 flex justify-end gap-2">
      <button
        type="button"
        id="delete_dialog_dismiss"
        class="rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50"
      >
        Voltar
      </button>
      <button
        type="button"
        id="delete_dialog_accept"
        class="rounded-md bg-red-600 px-3 py-2 text-sm font-medium text-white hover:bg-red-700"
      >
        Excluir
      </button>
    </div>
  </div>
</dialog>

<script src="../../scripts/confirmDelete.ts"></script>
