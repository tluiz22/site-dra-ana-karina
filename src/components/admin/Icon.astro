---
// Ícones inline (SVG, sem dependência nova) usados na navegação e nos
// cartões de estatística do admin — mantém o projeto sem lib de ícones.
export type IconName =
  | "home"
  | "calendar"
  | "users"
  | "check-circle"
  | "more"
  | "settings"
  | "chart-bar"
  | "logout"
  | "chevron-left"
  | "chevron-right"
  | "plus";

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = "h-6 w-6" } = Astro.props;

const paths: Record<IconName, string> = {
