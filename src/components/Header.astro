---
import { doctor } from "../data/doctor";
import { navigation } from "../data/navigation";
import WhatsAppButton from "./WhatsAppButton.astro";
import Monogram from "./Monogram.astro";
import Icon from "./Icon.astro";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) =>
  !href.includes("#") && (currentPath === href || currentPath.startsWith(`${href}/`));
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/94 backdrop-blur-sm">
  <div class="container-page flex h-(--header-height) items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-3 text-ink">
      <Monogram />
      <span class="flex flex-col">
        <span class="font-display text-brand font-medium">
          <span class="lg:hidden">{doctor.shortName}</span>
          <span class="hidden lg:inline">{doctor.professionalName}</span>
        </span>
        <span class="text-caption text-ink-muted">
          {doctor.specialtyLine}<span class="hidden sm:inline"> · {doctor.location}</span>
        </span>
      </span>
    </a>

    <nav aria-label="Navegação principal" class="hidden lg:block">
      <ul class="flex items-center gap-7 text-small font-medium">
        {
          navigation.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? "page" : undefined}
                class="py-2 text-ink-secondary transition-colors duration-150 ease-out hover:text-brand-hover aria-[current=page]:text-brand aria-[current=page]:underline aria-[current=page]:underline-offset-8"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hidden lg:block">
      <WhatsAppButton label="Agendar pelo WhatsApp" origin="Header" variant="compact" />
    </div>

    <button
      type="button"
      class="flex size-11 items-center justify-center rounded-icon border border-line-strong bg-surface text-ink lg:hidden"
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="menu-movel"
      data-menu-open
    >
      <Icon name="menu" size={20} />
    </button>
  </div>
</header>

<dialog
  id="menu-movel"
  aria-label="Menu"
  class="menu-dialog m-0 h-dvh max-h-none w-full max-w-none bg-bg p-0 text-ink lg:hidden"
>
  <div class="container-page flex h-(--header-height) items-center justify-between gap-6 border-b border-line">
    <span class="flex items-center gap-3">
      <Monogram />
      <span class="font-display text-brand font-medium">{doctor.shortName}</span>
    </span>
    <button
      type="button"
      class="flex size-11 items-center justify-center rounded-icon border border-line-strong bg-surface text-ink"
      aria-label="Fechar menu"
      data-menu-close
    >
      <Icon name="close" size={20} />
    </button>
  </div>

  <nav aria-label="Navegação principal (celular)" class="container-page pt-4">
    <ul>
      <li>
        <a
          href="/"
          aria-current={currentPath === "/" ? "page" : undefined}
          class="flex min-h-14 items-center border-b border-line font-display text-h3-display aria-[current=page]:text-brand"
          autofocus
        >
          Início
        </a>
      </li>
      {
        navigation.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? "page" : undefined}
              class="flex min-h-14 items-center border-b border-line font-display text-h3-display aria-[current=page]:text-brand"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <WhatsAppButton
      label="Agendar pelo WhatsApp"
      origin="Header mobile"
      class="mt-8 w-full"
    />
  </nav>
</dialog>

<style>
  .menu-dialog[open] {
    animation: menu-in 200ms ease-out;
  }
  .menu-dialog::backdrop {
    background: transparent;
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
</style>

<script>
  const dialog = document.getElementById("menu-movel") as HTMLDialogElement | null;
  const openButton = document.querySelector<HTMLButtonElement>("[data-menu-open]");
  const closeButton = document.querySelector<HTMLButtonElement>("[data-menu-close]");

  if (dialog && openButton) {
    openButton.addEventListener("click", () => {
      dialog.showModal();
      openButton.setAttribute("aria-expanded", "true");
      document.documentElement.style.overflow = "hidden";
    });

    closeButton?.addEventListener("click", () => dialog.close());

    // Escolher um link fecha o menu (inclusive âncoras da própria página).
    dialog.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) dialog.close();
    });

    // Esc fecha nativamente; em todos os casos o foco volta ao botão.
    dialog.addEventListener("close", () => {
      openButton.setAttribute("aria-expanded", "false");
      document.documentElement.style.overflow = "";
      openButton.focus();
    });
  }
</script>
