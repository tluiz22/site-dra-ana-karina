---
import { doctor } from "../data/doctor";
import { navigation } from "../data/navigation";
import WhatsAppButton from "./WhatsAppButton.astro";
---

<header class="border-b border-slate-200 bg-white">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-4 md:grid md:grid-cols-[1fr_auto_auto] md:gap-8">
    <a href="/" class="text-lg font-semibold text-slate-900 md:justify-self-start">
      {doctor.professionalName}
    </a>

    <nav aria-label="Navegação principal" class="hidden md:block md:justify-self-center">
      <ul class="flex items-center justify-center gap-8 text-sm font-medium text-slate-700">
        {navigation.map((item) => (
          <li>
            <a href={item.href} class="hover:text-slate-900">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="hidden md:block md:justify-self-end">
      <WhatsAppButton label="Agendar consulta" origin="Header" />
    </div>

    <details class="md:hidden md:justify-self-end">
      <summary
        class="cursor-pointer list-none rounded px-2 py-1 text-sm font-medium text-slate-700"
        aria-label="Abrir menu de navegação"
      >
        Menu
      </summary>
      <nav aria-label="Navegação principal (mobile)">
        <ul class="mt-2 flex flex-col gap-2 text-sm font-medium text-slate-700">
          {navigation.map((item) => (
            <li>
              <a href={item.href} class="block py-1 hover:text-slate-900">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-3">
          <WhatsAppButton label="Agendar consulta" origin="Header mobile" />
        </div>
      </nav>
    </details>
  </div>
</header>
