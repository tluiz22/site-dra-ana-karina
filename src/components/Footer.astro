---
import { doctor, whatsappHref, instagramHref } from "../data/doctor";
import Notice from "./Notice.astro";
---

<footer class="border-t border-line bg-bg">
  <div class="container-page grid gap-10 pt-14 pb-10 text-small text-ink-secondary md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="font-display text-h3-display text-ink">{doctor.professionalName}</p>
      <p class="mt-1.5">{doctor.crm} · {doctor.rqePediatria} · {doctor.rqePneumologia}</p>
      <ul class="mt-4 space-y-3">
        {doctor.locations.map((l) => (
          <li>
            <strong class="block font-semibold text-ink">{l.name}</strong>
            {l.address}
          </li>
        ))}
      </ul>
    </div>

    <ul class="flex flex-col gap-1" aria-label="Contato">
      <li>
        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          data-analytics-event="click_whatsapp_footer_link"
          class="link inline-flex min-h-11 items-center"
        >
          WhatsApp {doctor.displayPhone}<span class="sr-only"> (abre em nova aba)</span>
        </a>
      </li>
      <li>
        <a href={`mailto:${doctor.email}`} class="link inline-flex min-h-11 items-center break-all">
          {doctor.email}
        </a>
      </li>
      <li>
        <a
          href={instagramHref}
          target="_blank"
          rel="noopener noreferrer"
          class="link inline-flex min-h-11 items-center"
        >
          Instagram @{doctor.instagram}<span class="sr-only"> (abre em nova aba)</span>
        </a>
      </li>
    </ul>

    <ul class="flex flex-col gap-1" aria-label="Informações legais">
      <li>
        <a href="/politica-de-privacidade" class="link inline-flex min-h-11 items-center">
          Política de privacidade
        </a>
      </li>
      <li>
        <a href="/termos-de-uso" class="link inline-flex min-h-11 items-center">Termos de uso</a>
      </li>
    </ul>
  </div>

  <div class="container-page pb-12">
    <Notice variant="emergency" />
  </div>
</footer>
