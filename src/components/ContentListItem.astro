---
/**
 * Item das listas de Blog e Guias: lista com linhas no lugar de cartões com borda
 * (REDESIGN_SPEC §6, páginas internas). O título é o link; o bloco inteiro é clicável.
 */
interface Props {
  href: string;
  category: string;
  title: string;
  subtitle?: string;
  description: string;
  date?: Date;
}

const { href, category, title, subtitle, description, date } = Astro.props;
---

<li class="group relative border-t border-line py-7">
  <p class="eyebrow">{category}</p>
  <h2 class="mt-2 font-display text-h3-display font-medium text-ink">
    <a href={href} class="after:absolute after:inset-0 group-hover:text-brand group-hover:underline group-hover:decoration-1 group-hover:underline-offset-4">
      {title}
    </a>
  </h2>
  {subtitle && <p class="mt-1 text-ink-secondary">{subtitle}</p>}
  {
    date && (
      <time datetime={date.toISOString()} class="mt-1 block text-caption text-ink-muted">
        {date.toLocaleDateString("pt-BR", { day: "2-digit", month: "long", year: "numeric" })}
      </time>
    )
  }
  <p class="mt-3 max-w-[68ch] text-small text-ink-secondary">{description}</p>
</li>
